// Spells

COPY ~willowisp/spl-kit/l0wsinn1.spl~ ~override~

COPY ~willowisp/spl-kit/l0wssumm.SPL~ ~override~ //The new shaman dance
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
      match_parameter1 = 103121 // "A minor animal spirit answers your call."
 parameter1 = RESOLVE_STR_REF (@34)
  END
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
      match_parameter1 = 103122 // "A major animal spirit answers your call."
 parameter1 = RESOLVE_STR_REF (@35)
  END
    LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
      match_parameter1 = 103123 // "A minor nature spirit answers your call."
 parameter1 = RESOLVE_STR_REF (@36)
  END
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
      match_parameter1 = 103124 // "A major nature spirit answers your call."
 parameter1 = RESOLVE_STR_REF (@37)
  END
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
      match_parameter1 = 103120 // @38
 parameter1 = RESOLVE_STR_REF (@38)
  END

