 EXTEND_BOTTOM ~OH4000.bcs~   ~willowisp/baf/OH4000.baf~
 EXTEND_BOTTOM ~OH5100.bcs~   ~willowisp/baf/OH5100.baf~
 EXTEND_BOTTOM ~AR6103.bcs~   ~willowisp/baf/AR6103.baf~
 EXTEND_BOTTOM ~AR2401.bcs~   ~willowisp/baf/AR2401-dri.baf~
END

ACTION_IF GAME_IS ~iwdee~ BEGIN

// Will-o'-Wisp animation (because IWDEE is STUPID)

  LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0x7000 slotMax = 0x7999 RET slot END
  ACTION_IF (slot <= 0) BEGIN
    FAIL @241 // No free creature animation slot found.
  END
  LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
  APPEND ~animate.ids~ ~0x%hexNumber% WILL_O_WISP_IWDEE~ UNLESS ~WILL_O_WISP_IWDEE~
  CLEAR_IDS_MAP
  COPY ~%MOD_FOLDER%/bam-anim/iwdee/small/7xxx.ini~ ~override/%hexNumber%.ini~
  
// Will-o'-Wisp animation 2 (because IWDEE is STUPID)


  LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0x7000 slotMax = 0x7999 RET slot END
  ACTION_IF (slot <= 0) BEGIN
    FAIL @241 // No free creature animation slot found.
  END
  LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
  APPEND ~animate.ids~ ~0x%hexNumber% WILL_O_WISP_LARGE_IWDEE~ UNLESS ~WILL_O_WISP_LARGE_IWDEE~
  CLEAR_IDS_MAP
  COPY ~%MOD_FOLDER%/bam-anim/iwdee/large/7xxx.ini~ ~override/%hexNumber%.ini~


//
 
 COPY ~willowisp/itm/L0WSPDL.itm~ ~override~
 COPY ~willowisp/cre/L0WSPDM.cre~ ~override~
 WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~WILL_O_WISP_IWDEE~))
  SAY NAME1 @245
  SAY NAME2 @245
  
 COPY ~willowisp/itm/L0WSPWS.itm~ ~override~
 COPY ~willowisp/spl/L0WSPWS.spl~ ~override~
 COPY ~willowisp/spl/L0WSPWs2.spl~ ~override~
  SAY NAME1 @246
  SAY NAME1 @246
 COPY ~willowisp/cre/L0WSPWS.cre~ ~override~
 WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~WILL_O_WISP_LARGE_IWDEE~))
  SAY NAME1 @247
  SAY NAME2 @247
 
 COPY ~willowisp/cre-kit/l0tree.cre~ ~override~
 SAY NAME1 @33
 SAY NAME2 @33


 COMPILE ~willowisp/baf/L0WSPDM.baf~
 COMPILE ~willowisp/baf/L0WSPws.baf~
