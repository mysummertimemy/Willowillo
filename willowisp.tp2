COPY_EXISTING ~meliss01.bcs~ ~override~
              ~meliss02.bcs~ ~override~
              ~meliss03.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    REPLACE_TEXTUALLY ~\(See(Nearestenemyoftype(\[GOODCUTOFF\.UNDEAD\]))\)~ ~False() \1~
  END
BUT_ONLY

//FATESP and EET compatibility

ACTION_IF GAME_IS ~eet~ BEGIN
  INCLUDE ~EET/other/EET_functions.tph~
  LAF ~EET_NPC_TRANSITION~
    INT_VAR
      type = 2
      default_ToB = 1
    STR_VAR
      dv = "L0WILL"
      override_SoA = "L0WILL"
      override_ToB = "L0WILL25"
      dialog_ToB = "L0WILL25"
      //traFile = EVAL "%MOD_FOLDER%/translation/%LANGUAGE%/.tra"
      string = "Bring me Will, the spectral shaman."
      stringPosDV = "Wilson"
      cre_ToB = "L0will25"
  END
END ELSE BEGIN
  COMPILE ~%MOD_FOLDER%/d/FATESP.d~ //USING ~%MOD_FOLDER%/translation/%LANGUAGE%/.tra~
END

//Give Will proper spells accordingly to Witchlight's spheres

ACTION_IF FILE_EXISTS_IN_GAME ~RASPHERE.marker~ BEGIN

	REINCLUDE ~override\RASPHERE.tpa~

	ACTION_FOR_EACH creature IN l0will l0will25 BEGIN

		LAF	UPDATE_NPC_SPHERE	STR_VAR	npc_file = EVAL ~%creature%~ kitname = ~L0WS~ END

	
		ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ THEN BEGIN
      
			LAF RES_NUM_OF_SPELL_NAME STR_VAR	spell_name = ~WIZARD_SPOOK~ 	  		RET	spell_1 = spell_res	END
			OUTER_PATCH_SAVE spell_1 ~%spell_1%~ BEGIN	WRITE_ASCII	0 ~RA~ END
			LAF RES_NUM_OF_SPELL_NAME STR_VAR	spell_name = ~CLERIC_CURSE~		  		RET	spell_2	= spell_res	END
			LAF RES_NUM_OF_SPELL_NAME STR_VAR	spell_name = ~WIZARD_BLUR~		  		RET	spell_3	= spell_res	END
			OUTER_PATCH_SAVE spell_3 ~%spell_3%~ BEGIN	WRITE_ASCII	0 ~RA~ END
			LAF RES_NUM_OF_SPELL_NAME STR_VAR	spell_name = ~WIZARD_WRAITH_FORM~ 		RET	spell_4	= spell_res	END
			OUTER_PATCH_SAVE spell_4 ~%spell_4%~ BEGIN	WRITE_ASCII	0 ~RA~ END
			LAF RES_NUM_OF_SPELL_NAME STR_VAR	spell_name = ~CLERIC_WALL_OF_MOONLIGHT~	RET	spell_5	= spell_res	END
	  
			COPY_EXISTING ~%creature%.cre~ ~override~
	        REMOVE_MEMORIZED_SPELL ~SPPR113~
			REMOVE_KNOWN_SPELL ~SPPR113~
			REMOVE_MEMORIZED_SPELL ~SPPR104~
			REMOVE_KNOWN_SPELL ~SPPR104~
			REMOVE_MEMORIZED_SPELL ~SPPR210~
			REMOVE_KNOWN_SPELL ~SPPR210~
			REMOVE_MEMORIZED_SPELL ~SPPR302~
			REMOVE_KNOWN_SPELL ~SPPR302~
			REMOVE_MEMORIZED_SPELL ~SPPR401~
			REMOVE_KNOWN_SPELL ~SPPR401~
			ADD_MEMORIZED_SPELL ~%spell_1%~ #0 ~priest~ 
			ADD_KNOWN_SPELL ~%spell_1%~		#0 ~priest~
			ADD_MEMORIZED_SPELL ~%spell_2%~ #0 ~priest~
			ADD_KNOWN_SPELL ~%spell_2%~		#0 ~priest~		
			ADD_MEMORIZED_SPELL ~%spell_3%~ #1 ~priest~
			ADD_KNOWN_SPELL ~%spell_3%~		#1 ~priest~
			ADD_MEMORIZED_SPELL ~%spell_4%~ #2 ~priest~
			ADD_KNOWN_SPELL ~%spell_4%~		#2 ~priest~
			ADD_MEMORIZED_SPELL ~%spell_5%~ #3 ~priest~
			ADD_KNOWN_SPELL ~%spell_5%~		#3 ~priest~
			BUT_ONLY
		END	
		
	END
	
END

