  SAY NAME1 @246
  SAY NAME1 @246
 COPY ~willowisp/cre/L0WSPWS.cre~ ~override~
 WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~WILL_O_WISP~))
  SAY NAME1 @247
  SAY NAME2 @247
  
 COMPILE ~willowisp/baf/L0WSPDM.baf~
 COMPILE ~willowisp/baf/L0WSPws.baf~

 EXTEND_BOTTOM ~AR1404.bcs~   ~willowisp/baf/AR1404.baf~
 EXTEND_BOTTOM ~AR2100.bcs~   ~willowisp/baf/AR2100.baf~
 EXTEND_BOTTOM ~AR1900.bcs~   ~willowisp/baf/AR1900.baf~
