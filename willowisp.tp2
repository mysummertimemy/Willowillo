////////////////////Existing Area Change

COPY_EXISTING ar1400.are override
  LPF fj_are_structure
    INT_VAR
    fj_type         = 2    //travel
    fj_box_left     = 518
    fj_box_top      = 552
    fj_box_right    = 682
    fj_box_bottom   = 688
    fj_cursor_idx   = 42   // door
   fj_flags        = 4    // party required
   fj_flags        = 512  // NPCs can't pass
   fj_flags        = 516  // party required, NPCs can't pass
    fj_vertex_0     = 682 + (644 << 16)
    fj_vertex_1     = 659 + (559 << 16)
    fj_vertex_2     = 627 + (552 << 16)
    fj_vertex_3     = 584 + (562 << 16)
    fj_vertex_4     = 548 + (589 << 16)
    fj_vertex_5     = 518 + (613 << 16)
    fj_vertex_6     = 566 + (688 << 16)
    STR_VAR
    fj_structure_type   = region
    fj_name             = L0Trans // region name
    fj_destination_area = L00000      // *.ARE
    fj_destination_name = En          // entrance name
  END



