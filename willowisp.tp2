BACKUP ~willowisp\backup~
AUTHOR ~Lava Del'Vortel~
README ~willowisp\readme.txt~
VERSION ~v3.3~

AUTO_TRA ~willowisp/tra/%s~

ALWAYS
  INCLUDE ~%MOD_FOLDER%/lib/fl#add_kit_ee.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/always.tph~
  INCLUDE ~%MOD_FOLDER%/lib/functions.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/other_functions.tpa~
  INCLUDE ~%MOD_FOLDER%/RA_SPHERE_COMPAT.tpa~
END

LANGUAGE ~English~
         ~English~
         ~willowisp/tra/English/setup.TRA~

LANGUAGE ~Simplified Chinese (translation: Lzw104522773)~
         ~schinese~
         ~willowisp/tra/schinese/setup.TRA~

BEGIN @21
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @22
  LABEL L#-WILLOFTHEWISP-MAIN
  


//////////////////////////////////////////////////////////////////////////////////
////WILSON DOESN'T HAVE HIS BANTER FILE - THAT MAKES HIM SAD! LET'S CHANGE THAT///
//////////////////////////////////////////////////////////////////////////////////


ACTION_IF FILE_EXISTS_IN_GAME ~wilson.dlg~ THEN BEGIN
 PRINT @23
    APPEND ~interdia.2da~ ~WILSON BWILSON BWILSO25~
    UNLESS ~WILSON~
   ACTION_IF NOT (FILE_EXISTS_IN_GAME ~BWILSON.dlg~) THEN BEGIN
   COMPILE ~willowisp/d/BWILSONFix.d~
  END
   ACTION_IF NOT (FILE_EXISTS_IN_GAME ~BWILSO25.dlg~) THEN BEGIN
   COMPILE ~willowisp/d/BWILSO25Fix.d~
  END
END


////////////////////Existing Area Change

COPY_EXISTING ar2100.are override
  LPF fj_are_structure
    INT_VAR
    fj_loc_x       = 2275
    fj_loc_y       = 325
    fj_orientation = 2   // NW
    STR_VAR
    fj_structure_type = entrance
    fj_name           = L0NEW
  END


