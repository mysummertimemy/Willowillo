	COPY ~willowisp/bam-anim~ ~override~
END

 COPY ~willowisp/itm/L0WSPDL.itm~ ~override~
 COPY ~willowisp/cre/L0WSPDM.cre~ ~override~
 WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~WILL_O_WISP_SMALL~))
  SAY NAME1 @245
  SAY NAME2 @245
  
 COPY ~willowisp/itm/L0WSPWS.itm~ ~override~
