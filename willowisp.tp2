BEGIN @232
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet iwdee~ @22
  LABEL L#-WILLOFTHEWISP-ENEMIES


ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
 COPY ~willowisp/cre/L0drider.cre~ ~override~
  SAY NAME1 @233
  SAY NAME2 @233
END

ACTION_IF GAME_IS ~iwdee~ BEGIN
 COPY ~willowisp/cre/L0drider.cre~ ~override~
   PATCH_IF (SOURCE_SIZE > 0x2d3) THEN BEGIN
		ADD_CRE_ITEM ~s1-12m2~ #0 #0 #0 ~NONE~ ~WEAPON1~
	 END
  SAY NAME1 @233
  SAY NAME2 @233
  SAY BATTLE_CRY1 #-1
  SAY BATTLE_CRY2 #-1
  SAY BATTLE_CRY3 #-1
  SAY BATTLE_CRY4 #-1
  SAY BATTLE_CRY5 #-1
  SAY DAMAGE #-1
  SAY DYING #-1
  SAY HURT #-1
END

