/*

//HEALING

IF
Global("L0HealingExtra","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("L0HealingExtra","GLOBAL",1)
AddSpecialAbility("L0SPIHEA")
END

*/

IF
InParty(Myself)
Global("L0WillJoin25","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("L0WillJoin25","GLOBAL",1)
END


IF
Global("L0willSummonedToB","GLOBAL",1)
Global("L0StartWithMeToB","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("L0StartWithMeToB","GLOBAL",1)
StartDialogueNoSet(Player1)
END

IF
!AreaCheck("AR4000")
PartyHasItem("l0willne")
HPLT(Myself,2)
THEN
RESPONSE #100
CreateVisualEffectObject("SPCLOUD1",Myself)
DropInventory()
SetLeavePartyDialogueFile()
LeaveParty()
SetGlobal("L0WillJoin25","GLOBAL",0)
ForceSpellRES("L0heal",Myself)
ChangeAIScript("",DEFAULT)
DisplayStringHead(Player1,@19000)
MoveGlobal("AR4500","L0Will",[2242.1130])
END

