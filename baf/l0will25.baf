IF
InParty(Myself)
Global("L0WillJoin25","GLOBAL",1)
Global("L0WillUsualToB","GLOBAL",0)
THEN
RESPONSE #100
RealSetGlobalTimer("L0WillUsualToBTime","GLOBAL",600)
SetGlobal("L0WillUsualToB","GLOBAL",1)
END

IF
InParty(Myself)
CombatCounter(0)
!See([ENEMY])
See(Player1)
Global("L0WillUsualToB","GLOBAL",1)
RealGlobalTimerExpired("L0WillUsualToBTime","GLOBAL")
THEN
RESPONSE #100
SetGlobal("L0WillUsualToB","GLOBAL",2)
END

IF
Global("L0WillUsualToB","GLOBAL",2)
THEN
RESPONSE #100
