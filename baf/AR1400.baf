IFGlobal("L0StartWithOld","GLOBAL",0)THENRESPONSE #100SetGlobal("L0StartWithOld","GLOBAL",1)TriggerActivation("L0Trans",FALSE)ENDIFGlobalGT("L0TheVisionhive","GLOBAL",0)Global("L0EndWithNew","GLOBAL",0)THENRESPONSE #100SetGlobal("L0EndWithNew","GLOBAL",1)TriggerActivation("L0Trans",TRUE)TriggerActivation("Tran1403",FALSE)ENDIFGlobal("L0web","GLOBAL",0)Global("L0ShamanStronghold","GLOBAL",23)THENRESPONSE #100CreateCreature("l0spid",[4730.360],1)SetGlobal("L0web","GLOBAL",1)ENDIFInParty("L0Will")Global("L0WillSquirrel","GLOBAL",0)THENRESPONSE #100CreateCreature("l0sq",[2032.83],1)Explore()AddMapNote([2032.83],@0)SetGlobal("L0WillSquirrel","GLOBAL",1)ENDIF  GlobalGT("L0ShamanStronghold","GLOBAL",0)  Global("L0AddNote","AR1400",0)THEN  RESPONSE #100    RemoveMapNote([644.672],@1)    AddMapNote([644.672],@2)    SetGlobal("L0AddNote","AR1400",1)ENDIF!InParty("L0Will")Allegiance("L0Will",ENEMY)Global("L0WillHostile","AR1400",0)THENRESPONSE #100SetGlobal("L0WillHostile","AR1400",1)DisplayStringHead("L0Will",@3)ForceSpell("L0Will",DRYAD_TELEPORT)END