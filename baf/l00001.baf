IFGlobal("L0MotherCome","GLOBAL",0)THENRESPONSE #100CreateCreature("L0MOW",[2735.535],1)SetGlobal("L0MotherCome","GLOBAL",1)Continue()ENDIFGlobal("L0DeactivationUD","GLOBAL",0)THENRESPONSE #100SetGlobal("L0DeactivationUD","GLOBAL",1)AmbientActivate("L0porr",FALSE)TriggerActivation("EXIT",FALSE)Continue()ENDIFPartyHasItem("l0udkey")Global("L0DeactivationUD","GLOBAL",1)THENRESPONSE #100SetGlobal("L0DeactivationUD","GLOBAL",2)AmbientActivate("L0porr",TRUE)TriggerActivation("EXIT",TRUE)Continue()ENDIF!PartyHasItem("l0udkey")Global("L0DeactivationUD","GLOBAL",2)THENRESPONSE #100SetGlobal("L0DeactivationUD","GLOBAL",1)AmbientActivate("L0porr",FALSE)TriggerActivation("EXIT",FALSE)Continue()END