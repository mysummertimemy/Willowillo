@235  = ~Ten komponent wymaga zainstalowanego Willa.~
@236  = ~Dodanie dialogow miedzy-modowych miedzy Willem a Sirene~
@237  = ~Dodanie dialogow miedzy-modowych miedzy Willem a Pai'Na~
@238  = ~Dodanie dialogow miedzy-modowych miedzy Willem a Foundling~
@239  = ~Szaman Blasku Wiedzmy – samodzielna podklasa~
@240  = ~NPC Will jest juz zainstalowany.~
@241  = ~Nie znaleziono wolnego slotu animacji istot.~
@242  = ~[CHEAT] Wlaczenie twierdzy szamana dla wszystkich klas~

@243  = ~Miejskie Medium (Szaman) – podklasa~
@244  = ~Wyglada na to, ze twoja gra zawiera juz klase Miejskiego Medium.~

@245  = ~Upiorne światło~
@246  = ~Migotanie ognika~
@247  = ~Błędny ognik~
