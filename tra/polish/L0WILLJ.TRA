@0 = ~[will] Jesteśmy. To to miejsce, o którym wspominałem.~
@1 = ~[player] To miejsce roi się od plugastwa i pajęczyn. Załatw to szybko, żebyśmy mogli się stąd wynieść.~
@2 = ~[anomen] Dlaczego musimy przebywać w takim miejscu, <CHARNAME>? Z powodu tego ducha?~
@3 = ~[player] Jesteśmy tu, bo tak zdecydowałem, Anomenie. Tak czy inaczej, Willu... i co teraz?~
@4 = ~[player] Co takiego wyjątkowego jest w tym miejscu?~
@5 = ~[player] Tutaj? Serio? Yyy... jesteś pewien?~
@6 = ~[player] Okej. To czemu właściwie tu przyszliśmy?~
@7 = ~[will] To tutaj zginąłem... i z tym miejscem jestem związany. Ale odnowienie Wizjonarium dało mi dość mocy, by osłabić tę więź. Mogę się częściowo od niej uwolnić... na tyle, bym mógł z wami podróżować.~
@8 = ~[aerie] On... naprawdę zginął w tym cichym, smutnym miejscu? Jak straszne... musiał się czuć bardzo samotny.~
@9 = ~[player] Tak, to rzeczywiście smutne, Aerie, ale mimo wszystko powinniśmy pozwolić Willowi zrobić, co trzeba. Potrzebujesz pomocy?~
@10 = ~[player] Rozumiem. Zrób, co musisz, Willu — i ruszamy w drogę.~
@11 = ~[player] Potrzebujesz chwili, żeby... zrobić, co trzeba?~
@12 = ~[player] Mogę ci jakoś pomóc?~
@13 = ~[will] Mam wszystko, co potrzebne. To potrwa tylko chwilę.~
@14 = ~[will] Gotowe. Po sprawie.~
@15 = ~[player] W porządku jesteś?~
@16 = ~[player] Co właściwie zrobiłeś?~
@17 = ~[will] Tak... tak, wszystko gra.~
@18 = ~[player] Na pewno? Jeśli musisz dojść do siebie...~
@19 = ~[will] Jak już mówiłem — musiałem wpłynąć na moc, która mnie tu trzymała. To miejsce... dużo dla mnie znaczy. W końcu tutaj umarłem. Ale teraz...~
@20 = ~[will] Powinienem móc przychodzić i odchodzić, kiedy zechcę. Gdybym spróbował wcześniej, moja dusza zostałaby zniszczona i odtworzona tutaj. To miejsce działało jak kopuła, która mnie więziła. Musiałem powiązać część moich szczątków z tym amuletem — dzięki temu mogę zachować swoją postać.~
@21 = ~[will] Jest jeszcze coś, co powinieneś wiedzieć. Jeśli zginę w walce, twoja magia mnie nie wskrzesi — w końcu jestem tylko duchem. Ale nie odejdę na zawsze. Po jakimś czasie wrócę tutaj. Będziesz mógł tu przyjść i mnie odnaleźć. To chyba wszystko, co najważniejsze.~
@22 = ~[will] Nie będę kłamał — dziwnie się czuję, opuszczając to miejsce. Świat stoi przede mną otworem, ale minęło tyle czasu, odkąd widziałem coś poza tymi murami. Ale... jestem gotów.~
@23 = ~[player] Cieszę się, że to słyszę. Chodźmy — czas ruszać.~
@24 = ~[player] To twoja szansa, Willu. Nie ma tu miejsca na strach. Jesteś teraz bardziej wolny niż kiedykolwiek od chwili swojej śmierci. Wszystko będzie dobrze.~
@25 = ~[player] Dość już tego gadania. Ustaw się i ruszajmy. Przed nami sporo roboty.~
@26 = ~[will] Dobrze. Prowadź, a ja będę tuż za tobą.~
@27 = ~[will] Wiem. Ale to, co czuję, to nie strach. Może odrobina ciekawości i niepokoju... ale nie strach. Ruszajmy.~
@28 = ~[player] Ciszej. Po prostu prowadź nas dalej.~
@29 = ~[will] Co to... co to za miejsce...?~
@30 = ~[player] Jesteśmy w Athkatli. To Brama Miasta.~
@31 = ~[player] Jesteśmy w Athkatli. To dzielnica portowa.~
@32 = ~[player] Jesteśmy w Athkatli. To dzielnica nędzy.~
@33 = ~[player] Jesteśmy w Athkatli. To dzielnica mostowa.~
@34 = ~[player] Jesteśmy w Athkatli. To Promenada Waukeen.~
@35 = ~[player] Jesteśmy w Athkatli. To dzielnica świątynna.~
@36 = ~[player] Jesteśmy w Athkatli. To dzielnica rządowa.~
@37 = ~[player] Jesteśmy w Athkatli. To zachodnia część dzielnicy rządowej.~
@38 = ~[will] To Targowo. Miasto Kupieckiego Pokoju. Choć ostatnio z pokojem nie ma tu wiele wspólnego.~
@39 = ~[player] Co masz na myśli?~
@40 = ~[player] Nie mamy na to czasu. Ruszajmy dalej.~
@41 = ~[will] To miejsce... gdzie jesteśmy? Czy ono ma jakąś nazwę?~
@42 = ~[player] Nie mamy na to czasu, Willu. Chodźmy.~
@43 = ~[will] Pamiętam to miasto jako znacznie mniejsze, kiedy jeszcze żyłem. Po ulicach chodzili głównie ludzie, a teraz — elfy, krasnoludy, nawet niziołki... tylu różnych mieszkańców. I ta architektura — wszystko się zmieniło. Nic nie przypomina miejsca, które zapamiętałem.~
@44 = ~[player] Możliwe, że to, co pamiętasz, jest tylko echem tego, czym to miejsce stało się teraz.~
@45 = ~[player] Czyli zgaduję, że obecny wygląd miasta ci się nie podoba?~
@46 = ~[player] Heh. Z takim doborem metafor mógłbyś uchodzić za barda albo bajarza.~
@47 = ~[player] Obawiam się, że to nie czas na dyskusje o miastach i ich infrastrukturze. Ruszajmy, Willu.~
@48 = ~[will] Nie powiedziałem, że mi się nie podoba. To miasto i to sprzed lat to dwa zupełnie różne miejsca. Śmierć nauczyła mnie, że to czas definiuje przestrzeń. Pamiętam Athkatlę, która była ledwie połową tego, co widzę teraz — z innymi ludźmi i innym prawem.~
@49 = ~[player] Tamta dawna Athkatla to zupełnie inne miejsce. Twoja... ta, którą widzimy teraz, należy już do innej kultury.~
@50 = ~[will] Targowo też było inne. Może tylko połowę tak duże, znacznie bardziej... surowe. Mniej ludzi, choć kupców nadal było wielu. I pamiętam, że wokół miasta rosło więcej drzew.~
@51 = ~[will] Wątpię, by mi się to spodobało. Uwielbiam słuchać opowieści, ale samemu je snuć? Nie... nie jestem żadnym artystą. Poza tym nie sądzę, by nieumarły bard przyciągał tłumy.~
@52 = ~[will] Wracając do miasta... Athkatla za mojego życia była zupełnie inna. Twoja — ta, którą teraz widzimy — należy do zupełnie innej kultury.~
@53 = ~[will] A jeśli chodzi o Targowo — kiedy jeszcze żyłem, było inne. Mniejsze, bardziej surowe. Ludzi było mniej, ale kupców nie brakowało. I więcej drzew rosło wokół miasta.~
@54 = ~[will] Zastanawiam się... czy inne miasta też zmieniły się aż tak bardzo?~
@55 = ~[nalia] Cóż, Wrota Baldura były całkiem duże. Spędziłam tam trochę czasu, zanim pojmał mnie Irenicus.~
@56 = ~[player] To pewnie zależy od regionu. Bogatsze miejsca zmieniają się bardziej niż biedniejsze. Ale wszystkie chyba się zmieniają — choćby trochę.~
@57 = ~[player] Trudno mi powiedzieć. Niezbyt dobrze znam inne miasta.~
@58 = ~[will] Wrota Baldura, hmm? Chyba o nich słyszałem. To to wielkie miasto otoczone murem, który rozkazał wznieść sam Balduran, nad rzeką Chionthar, prawda? Nigdy tam nie byłem.~
@59 = ~[will] Przepraszam. To nie było zbyt mądre pytanie. Oczywiście, że każde miasto się zmienia. Minęło przecież tyle długich lat, odkąd...~
@60 = ~[will] ...~
@61 = ~[will] Mój ojciec był kupcem. Myślę, że to dlatego obraz miasta tak mocno mną poruszył. Ci wszyscy ludzie, żyjący swoim rytmem — kupujący, sprzedający, wydający pieniądze w okolicznych karczmach... Ojciec zwykł mawiać: "Pieniądz to życiodajna krew miasta, a jak krew — pędzi i nigdy nie zwalnia".~
@62 = ~[player] Ty i twój ojciec musieliście się dobrze dogadywać. Lubiliście się?~
@63 = ~[player] Hmm, sądzę, że bywają czasy, gdy ludzie mniej chętnie wydają złoto, ale rozumiem, co miał na myśli.~
@64 = ~[player] To wszystko bardzo wzruszające, ale naprawdę powinniśmy już ruszać.~
@65 = ~[player] Ojciec nauczył cię wiele o handlu?~
@66 = ~[will] Kochaliśmy się... przez większość czasu, przynajmniej. Nie chciał, żebym odchodził, i nie chodziło tylko o to, bym przejął rodzinny interes. Myślę, że wiedział... wiedział, że coś zawsze mnie dręczyło i nie pozwalało mi opuścić gardy. Martwił się o mnie.~
@67 = ~[will] Myślał, że zawsze będę go potrzebował i... może miał rację. Później w życiu często żałowałem, że nie mogłem zwrócić się do niego po pomoc. Ale jego już nie było... nie, *to mnie* już nie było. To ja oddaliłem się od niego.~
@68 = ~[will] Oczywiście. Ludzie zaciskają sakiewki, gdy czasy są trudne. Mój ojciec to wiedział. To było po prostu powiedzenie, które lubił. Myślę, że cieszyło go zarówno zarabianie, jak i wydawanie pieniędzy. Odnajdywał spokój w kupowaniu rzeczy, które sprawiały, że czuliśmy się bezpieczni i dobrze w domu.~
@69 = ~[will] Nie, nie bardzo. Zwykle tylko go obserwowałem. Ale wiedział, że jeśli handel naprawdę mnie zainteresuje, sam zechcę się go nauczyć. Ojciec troszczył się o mnie. Nie chciał, żebym odchodził — i nie chodziło tylko o interes. Myślę, że wiedział... że coś mnie dręczy i nie pozwala mi być naprawdę spokojnym. Martwił się.~
@70 = ~[will] Patrząc na to wszystko z perspektywy czasu... ojciec był dobrym człowiekiem. Może popełniłem błąd, trzymając swoje myśli tylko dla siebie. Kiedy dorosłem, rozmawialiśmy coraz mniej. Myślę, że to musiało go ranić.~
@71 = ~[player] A co z twoją matką?~
@72 = ~[player] Miałeś szczęście mieć kochającego ojca. Dlaczego z nim nie rozmawiałeś?~
@73 = ~[player] Dość tego, Willu. Powinniśmy ruszać dalej.~
@74 = ~[will] Była powieściopisarką, choć nie napisała zbyt wielu książek. Żadna nie była też zbyt długa, ale osobiście bardzo je lubiłem. Ojciec pomagał jej wydawać te opowieści. Wszystkie były fikcją, ale... (uśmiech) cóż, może nie były aż tak oderwane od rzeczywistości, jak myślałem. Dziś to już wiem.~
@75 = ~[player] Wiem o tym.~
@76 = ~[will] W każdym razie powinniśmy ruszyć dalej. Nie po to tu jesteśmy, ale... dziękuję. Chyba musiałem o tym porozmawiać.~
@77 = ~[player] Dobrze.~
@78 = ~[will] Dużo myślałem o ojcu, odkąd ostatnio o nim mówiłem... o tym, jak zostawiłem jego i matkę. Zastanawiam się, co się z nimi stało po moim odejściu. Może wyrządziłem im wielką krzywdę, odchodząc i nigdy nie wracając.~
@79 = ~[player] Możliwe, że tak... ale wszyscy popełniamy błędy.~
@80 = ~[player] Zrobiłeś to, co czułeś, że musisz zrobić. Usłyszałeś swoje powołanie i poszedłeś za nim. Wszyscy kiedyś to robimy — tylko okoliczności są inne.~
@81 = ~[player] To twoja sprawa, Willu. Wolałbym, żebyś nie poruszał tego przy mnie.~
@82 = ~[will] Może masz rację...~
@83 = ~[will] Okoliczności... zawsze są najważniejsze. Mogą ranić, niszczyć... albo dawać nadzieję.~
@84 = ~[will] Ale przeszłość jest już zbyt odległa. Cokolwiek się wydarzyło, dawno się skończyło. Zastanawiałem się, czy nie zapytać duchów o to, jaki los ich spotkał, ale nawet gdybym się dowiedział... nie mogłbym tego cofnąć. Więc nigdy nie zapytałem. I wątpię, bym kiedykolwiek to zrobił.~
@85 = ~[player] Przykro mi. To musi być dla ciebie trudne.~
@86 = ~[player] Naprawdę myślisz, że mnie to obchodzi, Willu? Trafiłeś pod zły adres z takimi wynurzeniami.~
@87 = ~[player] Na pewno nie chcesz zapytać? Nie ma nic złego w poznaniu prawdy. Może przyniosłoby ci to spokój. Może żyli dobrze.~
@88 = ~[player] Masz rację. Rozpamiętywanie przeszłości nikomu nie służy. Tak jak te miasta, o których mówiliśmy — przeszłość odeszła. Teraz żyjesz nowym życiem, w nowym świecie.~
@89 = ~[player] Nie chcę słuchać o twoich osobistych sprawach, Willu. Ruszajmy.~
@90 = ~[will] W porządku. Po prostu myślę na głos — nic więcej, nic mniej.~
@91 = ~[player] Wciąż uważam, że powinieneś zapytać duchy o swoich rodziców. Co masz do stracenia?~
@92 = ~[player] Po prostu pamiętaj ich takimi, jacy byli. Dowiedzenie się, kim się stali, może nie być dobrym pomysłem.~
@93 = ~[player] Jeśli potrzebujesz rady, idź do kogoś innego. To nie mój problem.~
@94 = ~[will] Muszę się nad tym poważnie zastanowić. Może gdybym wiedział, że wszystko z nimi było w porządku...~
@95 = ~[will] Tak, chyba masz rację. Odeszli dawno temu, ale... w moim obecnym stanie nie mogę przestać się zastanawiać, czy nie należę do przeszłości tak samo jak oni.~
@96 = ~[player] Masz ogromny wpływ na obecne czasy, Willu. Myślę, że naprawdę żyjesz — po prostu... inaczej.~
@97 = ~[player] Wpływasz na całe Krainy, nawet taki, jaki jesteś teraz. Nie jesteś tylko echem przeszłości. Jesteś równie żywy, jak ja i wszyscy, których spotykamy.~
@98 = ~[player] Może i należysz do przeszłości, ale to nie znaczy, że dziś jesteś bez znaczenia.~
@99 = ~[player] Jesteś tylko stratą energii. Możemy już ruszać?~
@100 = ~[will] Wpływ... Hmm... Nigdy nie myślałem o tym w ten sposób.~
@101 = ~[will] Miło wiedzieć, że mnie nie lekceważysz.~
@102 = ~[will] W każdym razie nie zrozum mnie źle. To nie tak, że mam o sobie niskie mniemanie. W końcu nie każdy potrafi rozmawiać z duchami. Nie każdy miał szansę stać się częścią Wizjonarium. I nie każdy dostaje drugą szansę na istnienie. Doskonale zdaję sobie z tego sprawę.~
@103 = ~[will] Sądzę, że rozumiesz, jak mocno przeszłość wpływa na to, kim jesteśmy. W końcu... jesteś dzieckiem Bhaala.~
@104 = ~[player] Nie byłem pewien, ile wiesz o moim dziedzictwie, Willu. Wygląda na to, że całkiem sporo.~
@105 = ~[player] Skąd to wiesz? Nigdy ci nie mówiłem ani o moim ojcu, ani o... ani o niczym innym!~
@106 = ~[will] Wiem mniej, niż ci się wydaje. Dla mnie jesteś po prostu <CHARNAME> — tym, który sam kształtuje swoją przyszłość. To ty decydujesz o swoich czynach. Nawet jeśli masz w sobie potencjał, jakiego inni nie mają, to twoje decyzje, umysł i dusza czynią cię tym, kim jesteś — nie twoja krew.~
@107 = ~[will] Wszedłeś do Wizjonarium, gdy wciąż tam byłem. My — szamani — widzimy więcej niż inni. Nie wspominając o szeptach i rozmowach tych, których spotykamy. Ale pamiętaj: dla mnie jesteś <CHARNAME> — tym, który sam kształtuje swoją przyszłość.~
@108 = ~[will] Bhaal był może okrutnym i brutalnym bogiem, ale nie żyje — nie ma już nad tobą żadnej władzy.~
@109 = ~[player] Czasami czuję, że moje decyzje zapadły już w dniu, w którym mnie spłodził. Wiele rzeczy było przesądzonych — na przykład to, że nigdy nie zaznam spokoju.~
@110 = ~[player] Dziękuję. Dobrze wiedzieć, że ktoś naprawdę wierzy, że jestem czymś więcej niż tylko istotą zła, która tylko czeka, by pożerać dusze niewinnych.~
@111 = ~[player] Wręcz przeciwnie — jestem dumny ze swojego dziedzictwa.~
@112 = ~[will] Rozumiem. Tak, to musi być dla ciebie bardzo trudne. Ale mam nadzieję, że mimo wszystko odnajdziesz spokój.~
@113 = ~[will] Heh, nie. Z tego, co wiem, dzieci Bhaala nie pożerają dusz. To raczej Rzeźnickożercy robią takie rzeczy... Bhaalspawny? Nie, raczej nie.~
@114 = ~[player] Naprawdę? Cóż... cieszę się dla ciebie, chyba.~
@115 = ~[will] W takim razie już cię nie będę niepokoić.~
@116 = ~[will] Opowiadano ci ciekawe historie, gdy byłeś dzieckiem? O magicznych miejscach, dziwacznych bestiach i zapierających dech w piersiach krainach?~
@117 = ~[player] Moje dzieciństwo nie było szczególnie ekscytujące, ale karczmarz z Candlekeep, Winthrop, opowiadał mi czasem różne historie. Dlaczego pytasz?~
@118 = ~[player] Nie za wiele. Jeśli miałem ochotę na opowieści, zakradałem się do głównej biblioteki i szukałem starych ksiąg. Zwykle trafiałem na coś ciekawego.~
@119 = ~[player] Nieszczególnie interesuje mnie takie bajdurzenie. Wolę szukać przygód w prawdziwym życiu niż w bajkach.~
@120 = ~[player] Wybacz, Willu, ale teraz naprawdę nie mamy czasu na pogawędki.~
@121 = ~[will] To musisz znać jakieś dobre opowieści! Może kiedyś się nimi wymienimy.~
@122 = ~[aerie] Naprawdę? Heh, trudno mi to sobie wyobrazić. Zawsze uważałam, że opowieści są inspirujące w tej swojej... niezwykłości.~
@123 = ~[will] Zawsze mnie fascynowały. Gdy byłem dzieckiem, często wymykałem się z domu — niezależnie od pory dnia — by posłuchać wędrownych bajarzy w okolicznych karczmach.~
@124 = ~[player] Musiałeś naprawdę to uwielbiać.~
@125 = ~[player] Na bogów, musiałeś być naprawdę upiornym dzieciakiem!~
@126 = ~[will] Każdy z nas robił coś podobnego w dzieciństwie. Z wiekiem zmieniają się zasady i schematy, którymi się kierujemy.~
@127 = ~[player] Wybacz, ale naprawdę powinniśmy już ruszać dalej.~
@128 = ~[will] Och, ja na pewno tak!~
@129 = ~[will] Cóż, przypuszczam, że są tacy, którzy by się z tobą zgodzili.~
@130 = ~[will] Chyba masz rację.~
@131 = ~[will] Może już ci to mówiłem, ale... przez moje zamiłowanie do opowieści matka nazywała mnie "Will-o’-wisp".~
@132 = ~[player] Tak, chyba było podobnie. Choć niełatwo powiedzieć, że to opowieści o bohaterach, przygodach i tajemnicach mnie ukształtowały.~
@133 = ~[player] Nie sądzę. Zawsze wiedziałem, że to tylko bajki. Myślę, że to prawdziwe doświadczenia mnie ukształtowały.~
@134 = ~[player] Naprawdę nie chcę o tym rozmawiać, Willu. Powinniśmy iść dalej.~
@135 = ~[will] Wiesz, cieszę się, że to powiedziałeś. Dobrze wiedzieć, że nie byłem jedyny, kto tak się czuł.~
@136 = ~[will] Myślę, że każdego motywuje coś innego, prawda? Dziękuję za szczerość, <CHARNAME>.~
@137 = ~[will] Zanim ruszymy dalej, mogę zadać ci jeszcze jedno pytanie?~
@138 = ~[player] Jasne. O co chodzi?~
@139 = ~[player] Wybacz, ale to nie jest dobry moment.~
@140 = ~[will] Gdybyś miał taką możliwość... czy zmieniłbyś swoją przeszłość?~
@141 = ~[player] Myślę, że tak. Popełniłem wiele błędów i są rzeczy, które powinienem był powiedzieć.~
@142 = ~[player] Nie. Może i popełniłem błędy, ale to część mojej przeszłości.~
@143 = ~[player] Nie wiem. Dopiero stojąc przed taką szansą, można zrozumieć jej cenę.~
@144 = ~[will] Rozumiem. Chyba będę musiał jeszcze o tym pomyśleć. Dziękuję, że mnie wysłuchałeś.~
@145 = ~[will] Rozumiem, co masz na myśli. Jesteś mądrym <PRO_MANWOMAN>.~
@146 = ~[will] Może masz rację. Może nigdy się nie dowiemy, co moglibyśmy zrobić.~
@147 = ~[will] W każdym razie przepraszam, jeśli moje pytanie zepsuło ci nastrój.~
@148 = ~[will] Powinniśmy ruszać. Przed nami jeszcze wiele do zobaczenia.~
@149 = ~[will] Dobrze. Nie będę ci już więcej przeszkadzał.~
@150 = ~[will] Czy to pora, byś odpoczął, <CHARNAME>? Mam pilnować ognia?~
@151 = ~[player] Tak, to by się przydało. Dzięki. A ty?~
@152 = ~[player] Myślę, że każdy już wie, co ma robić. Dobrego <DAYNIGHT>.~
@153 = ~[player] Nie, nie tym razem.~
@154 = ~[will] Przemyślałem twoje słowa i podjąłem decyzję. Porozmawiam z duchami.~
@155 = ~[player] Rozumiem. Zaczniesz teraz? Mogę zostać i pomóc?~
@156 = ~[player] Rób, co chcesz, ale ja nie biorę w tym udziału.~
@157 = ~[will] Tak, zostań. Nie musisz nic robić.~
@158 = ~[narrator] (Will klęka przy ogniu...)~
@159 = ~[narrator] (Zapada cisza. Widmo odwraca się w twoją stronę.)~
@160 = ~[will] Oni... byli szczęśliwi.~
@161 = ~[will] Moi rodzice żyli jeszcze prawie dwie dekady po moim odejściu...~
@162 = ~[player] Ale nadal nie wyglądasz na szczególnie szczęśliwego.~
@163 = ~[will] To dobrze. Byli szczęśliwi.~
@164 = ~[player] Meh... chyba idę spać.~
@165 = ~[player] Duchy powiedziały ci to wszystko?~
@166 = ~[will] Tak... pierwszy raz zapytałem duchy o coś osobistego.~
@167 = ~[will] Tak... znów masz rację.~
@168 = ~[will] Tak. To wszystko, czego chciałem się dowiedzieć.~
@169 = ~[will] Zanim się położysz... zostaniesz ze mną jeszcze chwilę przy ogniu?~
@170 = ~[player] Oczywiście. O co chodzi?~
@171 = ~[player] Nie. Jestem zbyt zmęczony.~
@172 = ~[will] Przemyślałem twoje słowa i uznałem, że miałeś rację.~
@173 = ~[player] Może i tak.~
@174 = ~[player] Nie mam ochoty o tym rozmawiać, Willu.~
@175 = ~[player] Możliwość rozmowy z duchami to cenna umiejętność.~
@176 = ~[player] Phi, myślałem, że chodzi o coś ważnego.~
@177 = ~[will] Hmm... jesteś brutalnie szczery.~
@178 = ~[will] Duchy to nie drogowskazy do zaginionych skarbów.~
@179 = ~[narrator] (Will przez chwilę zapatruje się w ogień.)~
@180 = ~[will] Na bogów, oddałbym wiele, żeby teraz napić się z tobą.~
@181 = ~[player] Heh, wiem, co masz na myśli.~
@182 = ~[player] Nie piję, Willu.~
@183 = ~[player] Robi się późno, Willu.~
@184 = ~[will] Wiesz... nigdy nie powiedziałem ci, dlaczego odszedłem.~
@185 = ~[player] Nie musisz mi mówić niczego, na co nie masz ochoty.~
@186 = ~[player] I tak bym w końcu zapytał.~
@187 = ~[player] Nie interesuje mnie to.~
@188 = ~[will] W porządku. Nie mam się czego wstydzić.~
@189 = ~[will] Zakochałem się. W Kirianie.~
@190 = ~[will] To nie dlatego, że ojciec by się sprzeciwił.~
@191 = ~[will] Z Kirianem często rozmawialiśmy...~
@192 = ~[player] Może twoja rodzina oczekiwała dziedzica?~
@193 = ~[player] Dlaczego nic mu nie powiedziałeś?~
@194 = ~[aerie] Ty? Nieśmiały wobec własnych uczuć?~
@195 = ~[aerie] Ten cały Kirian... myślisz, że wiedział?~
@196 = ~[will] Ha! Nie, wątpię.~
@197 = ~[will] Myślę, że to dlatego, że byłem dzieckiem.~
@198 = ~[will] Naprawdę? Nawet teraz uważam się za dość nieśmiałego!~
@199 = ~[will] Nie, raczej nie.~
@200 = ~[will] Heh... wygląda na to, że znowu zrobiłem się sentymentalny. A to jeszcze nie wszystko — mógłbym ci opowiedzieć o tym, jak pierwszy raz naprawdę się zakochałem.~
@201 = ~[will] Bogowie... o ile lepiej byłoby rozmawiać o takich sprawach z ciepłym ale w dłoni. Tak czy inaczej... myślę, że na dzisiaj wystarczy tej rozmowy, <DAYNIGHT>. Powinieneś odpocząć.~
@202 = ~[player] Rozumiem. W takim razie nie będę ci już przeszkadzał.~
@203 = ~[will] Mogę cię na chwilę zatrzymać, <CHARNAME>? Mam coś dla ciebie.~
@204 = ~[player] Ooo, prezent? Uwielbiam prezenty!~
@205 = ~[player] Masz coś dla mnie? Dlaczego?~
@206 = ~[player] Nie teraz, Willu. Mamy robotę do zrobienia.~
@207 = ~[will] Mam nadzieję, że sprawi ci tyle radości, co każdy inny prezent od przyjaciela.~
@208 = ~[will] Potraktuj to jako moje podziękowanie. Dużo ze sobą rozmawialiśmy i uznałem, że powinienem dać ci coś od siebie.~
@209 = ~[will] Proszę. Mówiłem, że żałuję, iż nie mogliśmy razem napić się ostatnio. Zapomniałem, że ty, w przeciwieństwie do mnie, możesz pić.~
@210 = ~[will] Obawiam się, przyjacielu, że będziesz musiał wypić za nas obu, heh.~
@211 = ~[player] Cóż, wygląda na porządny trunek. Dziękuję.~
@212 = ~[player] Przykro mi, Willu, ale mówiłem już — nie piję.~
@213 = ~[player] Naprawdę nie trzeba było. Ale... dziękuję.~
@214 = ~[player] Nieważne. Mamy co robić, więc lepiej ruszajmy dalej.~
@215 = ~[will] Cieszę się, że ci się podoba. Ja... cóż, wziąłem je z karczmy i zostawiłem parę monet.~
@216 = ~[player] Racja... zapomniałem. Ale i tak myślę, że powinieneś spróbować.~
@217 = ~[will] Był czas, kiedy zapomniałem dźwięku własnego głosu... To było jeszcze wtedy, gdy przebywałem w Wizjonarium.~
@218 = ~[will] Z tobą wszystko wygląda inaczej. Rozmawiamy, podróżujemy... czasami nawet zapominam, że jestem martwy.~
@219 = ~[player] Jak wyglądało życie w Wizjonarium?~
@220 = ~[player] Tak, tak, życie w grocie było dziwne. Możemy już skończyć ten temat?~
@221 = ~[will] Wewnątrz groty byłem tylko jednym z wielu.~
@222 = ~[will] Trudno to wyjaśnić, jeśli samemu się tego nie doświadczyło.~
@223 = ~[player] Brzmi okropnie. Żyć bez prywatności...~
@224 = ~[player] Brzmi to całkiem fascynująco, jak dla mnie.~
@225 = ~[player] Ilu duchów zebrało się, by stworzyć Wizjonarium?~
@226 = ~[player] Jak mówisz, słyszę tylko: "bla bla bla"...~
@227 = ~[will] Nie było tak źle, jak myślisz.~
@228 = ~[will] Tak, ale to oznacza także poświęcenie.~
@229 = ~[will] O wiele więcej. Teraz to już setki tuzinów.~
@230 = ~[will] Moje istnienie tutaj nie przypomina tego z Wizjonarium.~
@231 = ~[will] To jednak niewiele ma z tobą wspólnego, przyjacielu.~
@232 = ~[will] Myślałem, że ucieszy cię chwila przerwy, ale najwyraźniej się pomyliłem.~
@233 = ~[will] Chciałbym cię o coś zapytać, <CHARNAME>, o twoją przyjaciółkę... Imoen.~
@234 = ~[player] Kocham ją? Cóż, jak siostrę.~
@235 = ~[player] Jest dla mnie ważna, ale nie powiedziałbym, że ją kocham.~
@236 = ~[player] Nie jesteśmy kochankami. Jest jak młodsza siostra.~
@237 = ~[player] Nie, raczej nie.~
@238 = ~[player] Nie zamierzam rozmawiać z tobą o Imoen, Willu.~
@239 = ~[will] Rozumiem. A co z tym magiem... Irenicusem?~
@240 = ~[player] To długa historia.~
@241 = ~[player] To nie było żadne widowiskowe pojmanie.~
@242 = ~[player] To nie twoja sprawa, Willu.~
@243 = ~[will] Rozumiem. Nadal wiem niewiele o twojej przeszłości.~
@244 = ~[will] Zapytałem o Imoen, bo zastanawiałem się, czy wasza relacja to coś więcej.~
@245 = ~[player] Chętnie posłucham. Zacznij od początku.~
@246 = ~[player] To twoja prywatna sprawa, Willu.~
@247 = ~[player] Historia twojej pierwszej miłości?~
@248 = ~[will] Nazywał się Higam, był porucznikiem.~
@249 = ~[will] Zostawili go jego własni ludzie.~
@250 = ~[will] Zabrałem go do schronienia i opatrzyłem.~
@251 = ~[will] Po tygodniu jego ciało było prawie całkowicie wyleczone.~
@252 = ~[will] Heh, pamiętam, jak dużo rozmawialiśmy.~
@253 = ~[player] Co było dalej?~
@254 = ~[player] Próbujesz mnie zanudzić na śmierć tą historią?~
@255 = ~[will] Bywały trudne chwile... ale byliśmy szczęśliwi.~
@256 = ~[player] Ale to musiało się kiedyś skończyć.~
@257 = ~[player] Byliście bezpieczni i zakochani.~
@258 = ~[player] Bah, od tej słodyczy aż mnie mdli.~
@259 = ~[player] ...zmarł?~
@260 = ~[will] Heh, przynajmniej ja byłem szczęśliwy.~
@261 = ~[will] W końcu postanowiliśmy opuścić nasz azyl.~
@262 = ~[will] Tym razem to Higam się mną zaopiekował.~
@263 = ~[will] Zaczął słabnąć.~
@264 = ~[player] Przykro mi, Will.~
@265 = ~[player] To okrutne zakończenie smutnej historii.~
@266 = ~[player] Nigdy nie spotkałeś już nikogo, kogo mógłbyś pokochać?~
@267 = ~[player] Bah, co to za bzdury?~
@268 = ~[will] ...W porządku. Pogodziłem się ze stratą.~
@269 = ~[will] Tak... tak, byłem.~
@270 = ~[will] Nigdy.~
@271 = ~[will] Nie byłem całkiem wstrzemięźliwy od tamtej pory.~
@272 = ~[player] Utrata kogoś bliskiego zawsze boli.~
@273 = ~[player] Wiem. Czułem to samo, gdy straciłem Goriona.~
@274 = ~[player] Właśnie dlatego nie poddam się w walce o Imoen.~
@275 = ~[will] Tak, to prawda.~
@276 = ~[player] Właśnie dlatego staram się nie przywiązywać.~
@277 = ~[player] Nie sądzę, bym potrafił to zaakceptować.~
@278 = ~[will] Więc znasz ten gorzki smak utraty.~
@279 = ~[will] Dość już tego ponurego gadania.~
@280 = ~[player] Może i nie masz wyboru, ale szansa zawsze istnieje.~
@281 = ~[player] Tak... chyba już dość długo rozmawialiśmy.~
@282 = ~[player] To prawda, ale czy to nie też strata?~
@283 = ~[player] Sądzę, że trudniej będzie to zignorować.~
@284 = ~[player] Chodź, ruszajmy.~
@285 = ~[will] Widzę, że wybrałem zły moment.~
@286 = ~[will] Grosik za twoje myśli, <CHARNAME>?~
@287 = ~[player] Myślałem o Irenicusie.~
@288 = ~[player] Myślę o Imoen.~
@289 = ~[player] Och, musisz się mylić.~
@290 = ~[player] Zastanawiałem się nad jutrzejszym dniem.~
@291 = ~[player] To nie twoja sprawa.~
@292 = ~[will] Rozumiem. Po prostu chciałem z tobą porozmawiać.~
@293 = ~[will] Zastanawiam się... co zrobisz, gdy osiągniesz swój cel?~
@294 = ~[player] Nie myślałem jeszcze tak daleko.~
@295 = ~[player] Chciałbym założyć rodzinę.~
@296 = ~[player] Nie widzę siebie nigdzie indziej poza życiem poszukiwacza przygód.~
@297 = ~[player] Chcę potęgi.~
@298 = ~[player] Hmm... a może zostać szefem kuchni?~
@299 = ~[player] To nie twoja sprawa, Will.~
@300 = ~[will] Pewnie masz jeszcze mnóstwo czasu. Wątpię, by twoja podróż skończyła się w najbliższym miesiącu... ani tym po nim.~
@301 = ~[will] Rodzina, hm? Sądzę, że większość właśnie tego pragnie — życia u boku ukochanej osoby...~
@302 = ~[will] Chcesz zabawy, sławy i bogactwa, tak? Pragniesz odkrywać miejsca zapomniane przez świat, pełne magii i tajemnic. Rozumiem, czemu nigdy się nie nudzisz.~
@303 = ~[will] Szukać potęgi, mówisz. Widzę, że Irenicus zasiał w tobie dość silne ziarno.~
@304 = ~[will] Karczma? Heh, niezły pomysł. Spodziewałem się czegoś bardziej wzniosłego, ale skoro już to powiedziałeś... może faktycznie nie byłoby tak źle.~
@305 = ~[will] To ważne — mieć plan. Nie tylko na najbliższy czas, ale i na dalszą przyszłość. Nasze cele nas kształtują — ciało i duszę. Bez względu na to, czego szukamy, zmieniamy się... hartujemy umysł i siebie samych, by to osiągnąć.~
@306 = ~[player] Wyczuwam w tobie żal, Willu. To właśnie czujesz?~
@307 = ~[player] A co, jeśli ktoś w ogóle nie ma takiego celu? Jak myślisz — co się wtedy z nim dzieje?~
@308 = ~[player] Nie mam nastroju na filozoficzne rozważania, Willu.~
@309 = ~[Will] Tak. Ale obawiam się, że dotyczy to każdego z nas, <CHARNAME>.~
@310 = ~[Will] Nic, jak sądzę. Ani wiele, ani mało… po prostu nic.~
@311 = ~[Will] Czasem myślę, że nawet Irenicus może odczuwać żal. Może w jego przeszłości była zdrada albo niespełnione ambicje — coś, co wciąż go prześladuje.~
@312 = ~[Will] To mogło być drobne, a jednak znaczące… albo tak przytłaczające, że nawet ktoś o jego potędze nie potrafi się z tym uporać. Możliwości jest niewiele, ale jedno jest pewne — coś musiało się wydarzyć.~
@313 = ~[player] Próbujesz usprawiedliwiać jego czyny?~
@314 = ~[player] Uważasz, że mógł być kiedyś taki jak my? Że nie zaczął jako ktoś okrutny i bezlitosny?~
@315 = ~[player] Możemy na tym skończyć? Nie mam ochoty roztrząsać takich rzeczy, Willu.~
@316 = ~[Will] Nie, absolutnie nie. Jego czyny są niewybaczalne. Mimo to… nie potrafię przestać się zastanawiać, próbować zrozumieć — ale nie usprawiedliwiać. Nigdy.~
@317 = ~[Will] Nie wierzę, że ktokolwiek rodzi się okrutny. Gdyby tak było, czy nie stałbyś się Panem Mordu już dawno temu? Nie. To nasze czyny nas kształtują, a potem sami wybieramy swoje cele.~
@318 = ~[Will] Ale to rozmowa o tobie, nie o nim. Jak się czujesz? Wiele już się wydarzyło i obawiam się, że to jeszcze nie koniec.~
@319 = ~[player] Chyba w porządku. Jest dużo do zrobienia, ale… radzę sobie.~
@320 = ~[player] Bywało lepiej, ale… cóż, mam nadzieję, że w końcu nadejdzie coś dobrego.~
@321 = ~[player] Nie najlepiej. Zaczynam się zastanawiać, czy w ogóle czeka mnie jakaś nadzieja.~
@322 = ~[player] Przestań mi o tym przypominać, dobrze? Daj mi spokój, muszę odpocząć.~
@323 = ~[Will] Dobrze… to dobrze. Powstrzymamy tego szaleńca, który wypaczył twoją drogę.~
@324 = ~[Will] Odpocznij teraz. Nasza podróż ruszy dalej, gdy się obudzisz — nie wcześniej.~
@325 = ~[Will] Znajdź w sobie nadzieję, <CHARNAME>. Wszystko jeszcze może się ułożyć… a jeśli nie — sprawimy, że tak będzie.~
@326 = ~[Will] Ale teraz odpocznij. Jutro będzie lepszy dzień.~
@327 = ~[Will] Rozumiem… wolisz zostać sam. Jak sobie życzysz.~
@328 = ~[Boyerd] Zapraszam do obejrzenia najlepszych towarów Kompanii Rattlemotha! Ach, dzień dobry! Czy zechcecie obejrzeć nasze wyroby?~
@329 = ~[player] Kompanii Rattlemotha? Czy mogę zapytać, jak nazywa się założyciel tej firmy?~
@330 = ~[Boyerd] Boyerd Rattlemoth. Proszę, nie mów do mnie „pan” — wystarczy Boyerd. Nie jestem moim ojcem.~
@331 = ~[Boyerd] A jeśli chodzi o założyciela… cóż, firma powstała wiele pokoleń temu, za sprawą… eee… zdaje się, że nazywał się Basstler Rattlemoth. Dlaczego pytasz? …eee, czy wszystko w porządku? Wyglądasz bardzo blado.~
@332 = ~[Will] Tak, nic mi nie jest. Pytałem, bo… cóż, cenię firmy wierne swoim korzeniom. Dobrze wiedzieć, że wciąż pamiętacie tego, który zapoczątkował ten interes.~
@333 = ~[player] Wybacz, ale muszę porozmawiać z moim przyjacielem. Dobrego dnia, Boyerdzie.~
@334 = ~[Boyerd] Witajcie w Kompanii Rattlemotha. Czy chcielibyście obejrzeć nasze towary?~
@335 = ~[player] Tak. Pokaż, co masz.~
@336 = ~[player] Nie, dziękuję.~
@337 = ~[Will] A więc… mój ojciec musiał mieć jeszcze jednego syna. Nazwisko Rattlemoth przetrwało… a firma wciąż istnieje.~
@338 = ~[player] To było twoje nazwisko rodowe, prawda?~
@339 = ~[player] Nie wiedziałeś o tym? Cóż… chyba nie byłeś najlepszym synem.~
@340 = ~[Will] Tak.~
@341 = ~[Will] Być może masz rację. Powinienem był wiedzieć…~
@342 = ~[Will] Nigdy nie powiedziałem ci, jak miał na imię mój ojciec. Basstler — założyciel Kompanii Rattlemotha. Ten młody człowiek jest z mojej rodziny. Dzielimy… a raczej dzieliliśmy… tę samą krew.~
@343 = ~[player] Teraz wiesz, co się stało. Twój ojciec miał kolejne dziecko, a jego firma przetrwała i nadal dobrze sobie radzi.~
@344 = ~[player] To niczego już nie zmienia, Willu. Nie masz już swojej krwi i nie jesteś człowiekiem. Jesteś widmem kogoś, kto dawno temu opuścił swój dom.~
@345 = ~[player] Wygląda na to, że twoi rodzice mieli jeszcze jedno dziecko.~
@346 = ~[Will] Czuję ulgę, wiedząc to. Obawiałem się, że moje odejście skazało moich rodziców na samotność — że w chwili potrzeby nie mieli nikogo. Okazuje się, że się myliłem. Dobrze wiedzieć, że moje lęki były bezpodstawne.~
@347 = ~[player] Może i mieli inne dziecko, ale to nie znaczy, że twoje odejście ich nie zraniło.~
@348 = ~[player] Wygląda na to, że jednak nie byli sami. Nie miałeś powodów do obaw, Willu.~
@349 = ~[player] To wszystko brzmi wzruszająco, ale powinniśmy już iść dalej.~
@350 = ~[player] Twoje odejście mogło ich zranić, Willu. Nie wyciągaj zbyt pochopnych wniosków.~
@351 = ~[Will] Wolałbym wierzyć, że wciąż jest we mnie coś z człowieka, <CHARNAME>. Moje ciało nie żyje, ale myśli, wątpliwości i cele wciąż trwają — inaczej, lecz nadal. Tak czy inaczej… dobrze wiedzieć, że obawy były bezpodstawne. Wystarczy mi świadomość, że moim rodzicom niczego nie brakowało.~
@352 = ~[player] Może i mieli inne dziecko, ale to nie znaczy, że o tobie zapomnieli.~
@353 = ~[player] Nie wyciągaj zbyt optymistycznych wniosków. Mogłeś ich bardzo zranić.~
@354 = ~[Will] Oczywiście. Ale przynajmniej… przynajmniej nie byli sami. Przeżyli wystarczająco długo, by wychować kolejne dziecko, które mogli kochać.~
@355 = ~[player] Może i nie byli sami, Willu, ale ich syn zdecydował się ich opuścić. To bardziej skomplikowane, niż chcesz przyznać — nawet jeśli mieli inne dziecko, mogłeś ich zranić.~
@356 = ~[player] Mogli kochać to drugie dziecko, ale to nie znaczy, że o tobie zapomnieli. Twoje decyzje mogły mieć ogromny wpływ na ich życie.~
@357 = ~[player] Ale może… nieważne. Zapomnij. Wygląda na to, że mieli jednak dobre życie.~
@358 = ~[Will] A więc uważasz, że popełniłem błąd, odchodząc?~
@359 = ~[player] Być może. Zrobiliby wszystko, żebyś był szczęśliwy — a ty zdecydowałeś się odejść.~
@360 = ~[player] Nie. Zrobiłeś to, co uważałeś za słuszne. Ale nie mów, że było im dobrze tylko dlatego, że mieli inne dziecko. To mogłoby lekceważyć ich prawdziwe uczucia.~
@361 = ~[player] Nieważne. Możemy już iść?~
@362 = ~[Will] Hmm… cóż… ja…~
@363 = ~[Will] Myślisz… że tak…?~
@364 = ~[Will] Gdzieś głęboko wiem, że to może być prawda. To ja zdecydowałem się odejść. Skupiłem się na własnych uczuciach. Mogłem ich zranić — być może w sposób, którego nie da się naprawić. Ale dbałem o nich. O to, co mieliśmy. O ich nauki.~
@365 = ~[Will] Mogę brzmieć, jakbym nie dbał, ale dbałem, <CHARNAME>. Teraz mogę tylko wierzyć, że wciąż mieli powody do radości. I że czasem myśleli o mnie z czułością.~
@366 = ~[Will] Tak czy inaczej, dziękuję ci za to, że tu przyszliśmy i spotkaliśmy Boyerda. Ale powinniśmy już iść.~
@367 = ~[Will] *oddycha głęboko* Tak… czuję, jakby ogromny ciężar spadł mi z ramion.~
@368 = ~[Will] Dziękuję, że mnie tu przyprowadziłeś. Cieszę się, że mogłem spotkać Boyerda… moją krew. Nie powiem mu prawdy, ale… przynajmniej teraz wiem.~
@369 = ~[player] Jesteś pewien? To mogłoby dać ci prawdziwe domknięcie.~
@370 = ~[player] Dobrze. Chodźmy dalej.~
@371 = ~[Will] Tak. Wiedza o tym, że jego praprapra… wuj jest widmem, nie przyniosłaby mu nic dobrego. Lepiej, żeby był wolny ode mnie. Chodźmy.~
@372 = ~[player] Prowadź.~
@373 = ~[Will] Widzę, że znalazłeś kogoś, z kim możesz być naprawdę blisko, <CHARNAME>. Może nawet kogoś, kogo mógłbyś pokochać? Jeśli tak… cieszę się z tego.~
@374 = ~[player] Myślę, że tak. Dziękuję, że to zauważyłeś.~
@375 = ~[player] To trochę za dużo powiedziane. Coś czuję, ale „miłość” to słowo, którego nie używam lekko.~
@376 = ~[player] To może pójść w różne strony. Zobaczymy, co z tego wyniknie.~
@377 = ~[player] Moje sprawy osobiste nie są twoją sprawą, Willu. Nie wracajmy do tego.~
@378 = ~[Will] Dobrze wiedzieć, że masz tego świadomość.~
@379 = ~[Will] To zrozumiałe. To słowo ma swoją wagę.~
@380 = ~[Will] Takie rzeczy zawsze potrzebują czasu.~
@381 = ~[Will] Wspominałem ci kiedyś o tym, jak po raz pierwszy się zakochałem, ale…~
@382 = ~[player] Heh, nigdy nie mówiłeś, że podobają ci się mężczyźni. Wygląda na to, że jesteśmy do siebie bardziej podobni, niż myślałem.~
@383 = ~[player] Heh, nigdy nie mówiłeś, że podobają ci się kobiety. Tym bardziej cieszy mnie, że znalazłeś kogoś, kto jest ci bliski.~
@384 = ~[Will] Cóż, być może następnym razem to ty opowiesz swojemu widmowemu bratu historie o miłości i namiętności. *(uśmiech)*~
@385 = ~[Will] Cóż, być może następnym razem to ty opowiesz mi historie o wybranym przez ciebie mężczyźnie.~
@386 = ~[Will] Nie będę prawił kazań o tym, jak magiczny czy radosny potrafi być związek. Brzmiałoby to jak gaworzenie martwego człowieka. Dla każdego wygląda to inaczej. Z czasem sam zrozumiesz, czy znalazłeś właściwą osobę.~
@387 = ~[player] Dziękuję. Nie znoszę, gdy inni mówią mi, co powinienem czuć. Dobrze wreszcie usłyszeć coś innego.~
@388 = ~[player] Moim celem nigdy nie było znalezienie „prawdziwej miłości”. Jeśli ten związek nie okaże się tym, czego szukam, zakończę go — jeśli będzie trzeba.~
@389 = ~[player] Jestem tym wszystkim naprawdę podekscytowany. Mam tylko nadzieję, że nie tylko ja tak to odczuwam.~
@390 = ~[player] Nie chcę już o tym rozmawiać.~
@391 = ~[Will] I słusznie. Nikt nie powinien mówić ci, co masz czuć. Jeśli ktoś spróbuje — zignoruj go. Twoje uczucia należą wyłącznie do ciebie.~
@392 = ~[Will] Oczywiście. Tylko ty masz prawo zdecydować, co jest dla ciebie naprawdę właściwe.~
@393 = ~[Will] Jeśli jeszcze nie wiesz — zapewne wkrótce się dowiesz.~
@394 = ~[Will] Mam nadzieję, że nie masz mi za złe pytania, ale… czy to był twój pierwszy raz?~
@395 = ~[player] Nie.~
@396 = ~[player] Tak, ale zachowaj to dla siebie. To trochę krępujące, ale musiałem znaleźć kogoś, kto naprawdę coś dla mnie znaczył. Mam nadzieję, że rozumiesz.~
@397 = ~[player] Nie zamierzam o tym mówić. To moja prywatna sprawa.~
@398 = ~[Will] Rozumiem. *(uśmiech)* I dobrze. Szukanie więzi z innymi to zdrowa rzecz.~
@399 = ~[Will] Rozumiem! Mam nadzieję, że to nowe doświadczenie okaże się dla ciebie dobre.~
@400 = ~[Will] Mam tylko nadzieję, że nie zrobi się zbyt… *ekhm* niechlujnie. To się czasem zdarza… a bez wody albo pełnego bukłaka bywa naprawdę nieprzyjemnie.~
@401 = ~[Will]...yyy, powinienem za to przeprosić. Zwykle nie mówię takich rzeczy. Chyba nie powinienem był tego mówić na głos.~
@402 = ~[player]A teraz mnie zaciekawiłeś. Masz jakieś przemyślenia na ten temat?~
@403 = ~[player]Eee… chyba spoko. Po prostu ruszajmy dalej.~
@404 = ~[Will]Uwierzyłbyś, że ja też wiem, jak… *klejąco*… potrafi się zrobić?~
@405 = ~[player]Cóż, ta rozmowa nagle zrobiła się dziwna. Zapomnijmy, że w ogóle coś powiedzieliśmy.~
@406 = ~[player]Nie chcę o takich rzeczach rozmawiać, Will.~
@407 = ~[player]Wolałbym nie… Powiedzmy tylko, że ktoś się zbyt podekscytował i… zrobiło się trochę niezręcznie. Później się z tego śmialiśmy, ale *naprawdę* wolę nie wchodzić w szczegóły, heh. Zmieńmy temat.~
@408 = ~[Will]Racja…~
@409 = ~[Will]Heh. No cóż, wygląda na to, że naprawdę znasz te niezręczne sytuacje… eee, może po prostu ruszmy dalej?~
@410 = ~[Will]Skoro tak chcesz. Prowadź, idę za tobą.~

@411 = ~[Will]Ach... tyle tu duchów. Tyle echa... krzyczących i wirujących w ciemności...~
@412 = ~[player]Wszystko w porządku, Will? Zachowujesz się dość dziwnie, odkąd tu weszliśmy.~
@413 = ~[player]O czym ty mówisz?~
@414 = ~[player]Ja nic nie słyszę...~
@415 = ~[player]Nie mamy na to czasu. Ruszajmy.~
@416 = ~[Will]Gdy byliśmy jeszcze na powierzchni, słyszałem tylko szepty, ale tutaj… echo odbija się od wszystkich ścian. Słyszę głosy przeszłości, teraźniejszości i przyszłości. Wszystko się splata i kręci, jakby to był staw pełen węży i węgorzy.~
@417 = ~[player]Skup się, Will.~
@418 = ~[player]Nie myśl o tym. Zajmij się czymś.~
@419 = ~[Will]Tak...~
@420 = ~[Will]Ah... czuję się już trochę lepiej. To miejsce zupełnie nie przypomina Gniazda Wizji. Wręcz przeciwnie. Jest martwe, przepełnione negatywną energią. Na początku mnie to przytłoczyło, ale już dochodzę do siebie.~
@421 = ~[player]To dobrze. Wiesz, czego możemy się spodziewać w tym grobowcu?~
@422 = ~[player]Rozumiem. Ruszajmy dalej.~
@423 = ~[Will]Pułapek, zimnych kamieni, cieni, padliny. Może nieumarłych. Niczego, co żywi uznaliby za przyjemne, obawiam się.~
@424 = ~[Will]To miejsce jest ostoją zmarłych. Żywi nie powinni tu przebywać zbyt długo. Zróbmy, co trzeba, <CHARNAME>, i wynośmy się stąd jak najszybciej.~
@425 = ~[player]Dobrze. Postaram się zignorować te szepty. Załatwmy, co trzeba, i zmywajmy się stąd jak najszybciej.~
@426 = ~[Will]Zastanawiałem się, <CHARNAME>… czy jesteś szczęśliwy z tym, kim jesteś?~
@427 = ~[player]Trudno powiedzieć. Szczerze mówiąc, nie wiem. Od chwili, gdy opuściłem Candlekeep, wydarzyło się zbyt wiele. Więcej, niż się spodziewałem.~
@428 = ~[player]Chyba tak. Nawet jeśli życie mnie nie oszczędzało, mogło być gorzej. Wciąż żyję i to mnie cieszy.~
@429 = ~[player]Nie, Will. Zbyt wielu bliskich straciłem. Najpierw Goriona, potem Khalida i Dynahier. Nawet nie miałem okazji ich opłakać.~
@430 = ~[player]Przestań zadawać mi te bezsensowne pytania, Will. Ruszajmy.~

@431 = ~[Will]Ten czas musiał być dla ciebie trudny. Nic dziwnego, że nie umiesz nawet powiedzieć, czy jesteś szczęśliwy. Wierz lub nie, ale to mnie smuci.~
@432 = ~[Will]Cieszę się to słyszeć. Wiem, że spotkało cię wiele złego — straty, porwanie Imoen — ale jesteś silnym <PRO_MANWOMAN>, skoro mimo to potrafisz odnaleźć szczęście.~
@433 = ~[Will]Przykro mi to słyszeć. Powinieneś przynajmniej mieć czas, by się pożegnać.~
@434 = ~[Will]Też miałem chwile, gdy czułem się słaby i bezradny. Gdy straciłem Higama — tego, którego kochałem. Byłem jednocześnie smutny i wściekły. Piłem, aż topiłem się w alkoholu, a potem milczałem całymi dniami. Przestałem dbać o innych, nawet jeśli mnie wołali — ignorowałem ich.~

@435 = ~[player]Ale jakoś się z tego podniosłeś.~
@436 = ~[player]Nie było to niesprawiedliwe wobec tych, którzy cię potrzebowali?~

@437 = ~[Will]Tak. Ale to zajęło dużo czasu… bardzo dużo czasu.~
@438 = ~[Will]Możliwe. Ale utrata Higama też była niesprawiedliwa. „Dlaczego mam ratować kogokolwiek, skoro nie zdołałem ocalić tego, którego kochałem najbardziej, ani nawet siebie?” Powtarzałem to sobie wiele razy.~
@439 = ~[Will]Chciałem tylko powiedzieć, <CHARNAME>… jeśli kiedykolwiek będziesz potrzebować pomocy… jeśli poczujesz się przytłoczony… daj mi znać. Nie powiem ci, że wszystko będzie dobrze. Nie skłamię. Ale cię wysłucham. A jeśli nie chcesz mówić — po prostu posiedzimy razem przy ogniu. Cokolwiek ci pomoże.~

@440 = ~[player]Dlaczego jesteś taki miły?~
@441 = ~[player]Nie potrzebuję nikogo, Will. Nie jestem słabeuszem.~
@442 = ~[player]Dziękuję. Zapamiętam to.~

@443 = ~[Will]Bo mogę. Pomogłeś mi. Pomagasz innym, nawet jeśli nic w zamian nie dostajesz. Zasługujesz przynajmniej na tyle.~
@444 = ~[Will]Jestem do twoich usług, przywódco... przyjacielu.~
@445 = ~[Will]Heh… gdybym żył, zaproponowałbym kufel piwa albo ucztę, ale oboje wiemy, jak z tym jest. Nie mogę pić ani jeść. Heh, nawet zapalić bym nie mógł. Szkoda.~

@446 = ~[player]Przynajmniej możemy rozmawiać. Dla mnie to wystarczy.~
@447 = ~[player]Paliłeś za życia?~
@448 = ~[player]Nieważne. Możemy już iść?~

@449 = ~[Will]Obawiam się, że to wszystko, co mogę ci zaoferować. Ale to i tak lepsze niż nic.~
@450 = ~[Will]Czasem zapaliłem fajkę z tytoniem. Nie nazwałbym się palaczem, ale nie byłem od tego wolny. Próbowałem też Haunspeiru i Czerwonych Liści parę razy, ale to nie dla mnie.~
@451 = ~[Will]W każdym razie, powinniśmy ruszać. Ale jeśli mnie potrzebujesz — zawsze jestem gotów cię wysłuchać.~
@452 = ~[player]Dobrze. Już cię więcej nie będę niepokoić.~

@453 = ~[Will]Muszę się do czegoś przyznać, <CHARNAME>. Gdy zrozumiałem, że znalazłeś kogoś bliskiego… przypomniałem sobie siebie. To, jak czułem się przy Higamie. Może i jesteśmy teraz rozdzieleni, ale widok twojej więzi z kimś przywrócił mi trochę życia.~

@454 = ~[player]Zdecydowanie dobrze mieć kogoś, kto się troszczy.~
@455 = ~[player]Wiesz, Will, to może nie potrwać wiecznie. Nie przywiązuj się zbytnio. Nauczyłem się, że wszystko — nawet więzi — mogą się zmienić.~
@456 = ~[player]To moje życie, Will, nie twoje. Trzymaj się z daleka od moich spraw.~
@457 = ~[player]To moja prywatna sprawa, Will. Nie chcę, byś się w to mieszał.~

@458 = ~[Will]Nie martw się. Wiem o tym.~
@459 = ~[Will]Co? Myślisz, że chcę żyć twoim życiem? Chciałem tylko powiedzieć, że cieszę się z twojego szczęścia. Jeśli to cię drażni…~
@460 = ~[player]Wybacz. Jestem ci wdzięczny, że tak się czujesz. Po prostu nie chciałem czuć się pod presją.~

@461 = ~[Will]Tylko co, jeśli to się nie uda? Jeśli wszystko się posypie i znów zostaniemy tylko towarzyszami?~
@462 = ~[player]Nie obchodzi mnie to. Trzymaj się z daleka.~
@463 = ~[Will]Heh, pewnie masz rację. Przepraszam — po prostu minęło sporo czasu, odkąd czułem coś takiego, jak ty teraz.~

@464 = ~[Will]Chciałem jeszcze coś ci powiedzieć, <CHARNAME>.~
@465 = ~[player]Rozumiem. Nic się nie stało.~

@466 = ~[Will]Słuchaj, nie chcę, żebyś myślał, że cię obserwuję, naciskam czy oceniam. Po prostu… za długo nie rozmawiałem z nikim żywym. Odkąd stałem się czymś więcej niż bytem wizji czy snu, chyba trochę się w tym wszystkim duszę.~
@467 = ~[Will]Chcę tylko, żebyś wiedział, że… uważam cię za prawdziwego przyjaciela. Za <PRO_BROTHERSISTER>. Może nie z krwi, ale z więzi.~

@468 = ~[player]Szczęściarz ze mnie. Gdybyśmy dzielili krew, też byłbyś pomiotem Bhaala! …Heh, dzięki, Will. Uważam cię za dobrego przyjaciela i to dla mnie zaszczyt.~
@469 = ~[player]Słuchaj, Will. Uważam cię za cennego towarzysza. Jesteś szamanem z użytecznymi zdolnościami i mogę z nich korzystać. Może to cię rozczaruje, ale nie będę kłamał z grzeczności.~
@470 = ~[player]Zabawne, bo ja też myślę o tobie jak o bracie, Will. Prawdziwym. Takim, z którego mogę być dumny — nie tylko kolejnym noszącym moje brzemię.~
@471 = ~[player]Nie rozśmieszaj mnie, duchu. Jeśli szukasz czułości, wezwij sobie jakieś duchy i niech cię zabawią. Mnie to nie interesuje.~

@472 = ~[Will]Dziękuję.~
@473 = ~[Will]…Heh. Zaczyna się robić zbyt sentymentalnie jak na mój gust. Powiedzieliśmy, co chcieliśmy. Może wróćmy do zadań, co?~
@474 = ~[player]Masz rację. Ruszajmy.~
@475 = ~[Will]Chciałem ci jeszcze coś powiedzieć.~
@476 = ~[player]Tak? Co takiego?~

@477 = ~[Will]Naprawdę sądzisz, że nam się uda? Że pokonamy Irenicusa i każdego potwora, którego zdołał sobie podporządkować?~
@478 = ~[Will]Czy w ogóle się mnie nie boisz? Wiesz, czym są pomioty Bhaala i znasz zło jego imienia. Musiałeś to wiedzieć nawet za życia.~
@479 = ~[Will]Ciężko to przyznać, ale… chyba się w tobie zakochuję.~

@480 = ~[player]Nic. To nic. Ruszajmy dalej.~
@481 = ~[Will]Rozumiem, <CHARNAME>. Dziękuję za szczerość. Chyba już wystarczająco długo zajmuję twój czas, więc… prowadź.~
@482  = ~[player] No to chodźmy.~
@483  = ~[will] Tak. Wierzę, że nam się uda. Bez względu na to, jak podstępny i potężny by nie był, my również nie jesteśmy zwyczajni. Stajemy z nim do walki z konkretnego powodu i mamy cel, do którego dążymy.~
@484  = ~[will] Myślę, że Irenicus popełnił ogromny błąd w dniu, w którym postanowił stanąć przeciw pomiotowi Bhaala na moich oczach.~
@485  = ~[will] Nie, nie boję się. Po pierwsze, staram się nie oceniać ludzi, zanim ich nie poznam. A nawet gdybym to robił, nie opieram swoich osądów na tym, co mówią inni, <CHARNAME>.~
@486  = ~[will] Po drugie — czego właściwie miałbym się obawiać? Czy mógłbyś zesłać mnie do Dziewięciu Piekieł, gdybyś chciał? Heh. Prawdę mówiąc, wierzyłem, że mogę ci zaufać. I sądzę, że była to najlepsza decyzja, jaką mogłem podjąć.~
@487  = ~[will] Ty... jesteś we mnie zakochany? Przykro mi, <CHARNAME>, ale postrzegałem cię raczej jak <PRO_BROTHERSISTER>, nie— wybacz. Gdybym wiedział, że tak się czujesz, może powinienem był wcześniej jasno wyrazić swoje myśli.~
@488  = ~[will] Jesteś wspaniałą osobą i... bez wątpienia świetnym kochankiem, ale... ja jestem martwy. Ty nie. Nie przemierzam Pierwotnej Sfery Materialnej w poszukiwaniu miłości.~
@489  = ~[will] Przykro mi.~
@490  = ~[will] Chyba źle zrozumiałem naszą relację. Nie powinienem był cię tym kłopotać.~
@491  = ~[will] Mam do ciebie pytanie, <CHARNAME>.~
@492  = ~[will] Jaki typ kobiet cię pociąga, hmm? Heh. Wiem, że nie zawsze kończymy z osobą, którą wybieramy, ale musi być coś, co szczególnie cię przyciąga.~

@493  = ~[player] Ty duchowy draniu! Heh... właściwie to podobają mi się zarówno mężczyźni, jak i kobiety. Wszystko zależy od konkretnej osoby.~
@494  = ~[player] Co mnie pociąga... hmm. Lubię wyjątkowość. Coś... szczególnego. Coś, co odróżnia ją od innych.~
@495  = ~[player] Pociąga mnie bystry umysł. Może dlatego mam słabość do moli książkowych, heh.~
@496  = ~[player] Jestem prostym <PRO_MANWOMAN>. Podobają mi się atrakcyjne kobiety. Taki już jestem, ha!~
@497  = ~[player] Lubię kobietę, która potrafi skopać tyłek i zadbać o siebie. Nie mam nic przeciwko temu, by czasem to mnie ratowano!~
@498  = ~[player] Nie chcę o tym rozmawiać. Naprawdę.~

@499  = ~[will] Rozumiem. Nie mam tu wielkiego doświadczenia, więc znalezienie jakiegoś schematu zajęłoby mi trochę czasu... jeśli w ogóle jakiś istnieje!~
@500  = ~[will] Hmm, rozumiem... (uśmiecha się figlarnie)~
@501  = ~[will] A jaki typ mężczyzn cię pociąga, hmm? Heh. Zastanawiałem się, czy mamy podobny gust, czy też zwracasz uwagę na... zupełnie inne cechy.~

@502  = ~[player] Ty mały...! Heh... właściwie to podobają mi się zarówno mężczyźni, jak i kobiety, więc zdziwiłbym się, gdybyś znalazł tu jakieś wspólne schematy.~
@503  = ~[player] Co mnie pociąga... hmm. Lubię wyjątkowość. Coś innego. Coś, co wyróżnia go spośród innych.~
@504  = ~[player] Wiesz, chyba mam fetysz na brodatych mężczyzn. Zwłaszcza takich drapiących. Nazywaj mnie dziwakiem, jeśli chcesz, ale zakochuję się po uszy w potężnych „brodomantach”!~
@505  = ~[player] Lubię mężczyzn, którzy myślą głową. Potrafię wyobrazić sobie idealnego partnera w spokojny dzień — książka w jednej ręce, kielich wina w drugiej.~
@506  = ~[player] Lubię mężczyznę, którego mogę chronić, takiego, który może na mnie polegać. Sprawia mi przyjemność pomaganie tym, na których mi zależy.~
@507  = ~[player] Jestem prostym <PRO_MANWOMAN>. Podobają mi się silni, przystojni mężczyźni.~
@508  = ~[player] Wybacz, ale to nie jest coś, o czym chciałbym z tobą rozmawiać, Will.~

@509  = ~[will] Rozumiem. Cóż, nie mam w tym dużego doświadczenia i nie będę udawał, że jest inaczej. Możliwe, że masz rację — mógłbym nie dostrzec żadnych podobieństw.~
@510  = ~[will] Hmm, potrafię to sobie wyobrazić. (uśmiecha się figlarnie)~
@511  = ~[will] „Brodomanta”? Hah! Dobre. Skoro już o brodach mowa... heh. Widzisz moją, prawda? Dlaczego myślisz, że od początku ciągnęło mnie do Higama? Cóż, to było coś więcej niż tylko to, ale... heh, chyba rozumiesz.~
@512  = ~[will] Powód, dla którego o to zapytałem, jest taki, że zastanawiałem się... czy kiedykolwiek wstydziłeś się swoich uczuć?~

@513  = ~[player] Bogowie, nie! Dlaczego w ogóle pytasz?~
@514  = ~[player] Nie, nigdy. Pamiętaj, nie wychowywała mnie pełna rodzina. Poza Gorionem była tylko Imoen, która nigdy by mnie za nic nie oceniała. Choć gdybym powiedział Gorionowi, że mam uczucia, dajmy na to, do jakiegoś Zhenta, to nie powiem, żebym nie poczuł odrobiny wstydu.~
@515  = ~[player] Na początku byłem zagubiony we własnych uczuciach, ale teraz już nie. Jestem szczęśliwy z tym, kim jestem.~
@516  = ~[player] Na początku byłem zagubiony we własnych uczuciach... i nawet teraz trochę jestem. Zawsze trudno rozmawiać z innymi, gdy nigdy nie wiadomo, czy czują to samo.~
@517  = ~[player] Tak... raz mi się to zdarzyło.~
@518  = ~[player] Nie chcę o tym rozmawiać. Chodźmy dalej.~
@519  = ~[will] Gdy po raz pierwszy zakochałem się w Kirianie, czułem pewien wstyd. Teraz już nie — wiem, że nie było w tym nic złego — ale wciąż nie wiem, co powiedziałbym ojcu.~
@520  = ~[player] Cóż, to rzeczywiście byłaby dość skomplikowana sytuacja.~
@521  = ~[player] Rozumiem.~
@522  = ~[will] Nie ma tu niczego, co wymagałoby wyjaśniania, <CHARNAME>. Jesteś w porządku dokładnie taki, jaki jesteś.~
@523  = ~[will] Rozumiem. Nie będę już więcej pytał.~
@524  = ~[will] Pytałem, bo często się nad tym zastanawiam… dlaczego tak wielu ludzi wstydzi się tego, co czuje do innych — bez względu na to, czy chodzi o mężczyzn, czy kobiety? Czy nie powinniśmy mieć wolności, by samodzielnie decydować, jak patrzymy na innych?~
@525  = ~[will] Tak wielu unika rozmów o własnych uczuciach, jakby wstydzili się swojego życia, swojej miłości… albo nawet godności.~
@526  = ~[player] Nie ma powodu do wstydu. Ale przyznanie się do tego wymaga odwagi.~
@527  = ~[player] Ludzie boją się burzyć status quo. To nie zawsze kwestia wstydu.~
@528  = ~[player] Nie wiem i szczerze mówiąc — nie chcę się nad tym zastanawiać. Możemy to już zostawić?~
@529  = ~[player] Myślę, że najpierw trzeba nauczyć się akceptować samego siebie. Może wstyd pojawia się wtedy, gdy ktoś nie jest jeszcze na to gotowy.~
@530  = ~[player] To naprawdę trudne pytanie… chciałbym odpowiedzieć, ale nie wiem, co powiedzieć.~
@531  = ~[player] Chyba masz rację.~
@532  = ~[player] Status quo? Dlaczego miałoby kogokolwiek ograniczać? Czy poglądy większości zawsze muszą być jedyną słuszną drogą? Ludzie są różni — każdy ma własne myśli i uczucia. Dlaczego zdanie jednej osoby miałoby być mniej warte niż zdanie setki innych?~
@533  = ~[player] Być może masz rację. To pewnie dlatego ludzie przybierają różne maski.~
@534  = ~[will] Widzę, że myślimy podobnie.~
@535  = ~[will] Zastanawiam się nad tym, bo naprawdę chciałbym, żeby wszystko było prostsze. Bez względu na to, ile czasu mija, niektóre zasady zdają się nigdy nie zmieniać.~
@536  = ~[will] Czy byłbyś szczęśliwy, gdyby twój przybrany ojciec — Gorion — miał okazję poznać osobę, którą wybrałeś?~
@537  = ~[player] Tak. Szkoda, że to niemożliwe.~
@538  = ~[player] Nie bardzo. Myślę, że byłoby to dość niezręczne. I tak nie byliśmy sobie szczególnie bliscy.~
@539  = ~[player] Nie wiem… może?~
@540  = ~[will] Mm… Ja… chciałbym, żeby mój ojciec zobaczył mnie razem z Higamem, ale to już nigdy się nie wydarzy.~
@541  = ~[will] Ale dość już tego, <CHARNAME>! Przed nami jeszcze wiele do zrobienia i zobaczenia, prawda? Chodź, przyjacielu — przyszłość na nas czeka!~
@542  = ~[will] Chyba nie powinienem był cię tym wszystkim męczyć.~
@543  = ~[will] Nie jesteś jeszcze zbyt zmęczony, <CHARNAME>? Co powiesz na partyjkę kart przed snem?~
@544  = ~[player] Gra losowa, tak? Mogę ci ufać, że nie będziesz podpytywał duchów o moje karty?~
@545  = ~[player] Brzmi dobrze. Rozdaj karty.~
@546  = ~[player] Nie, wolę się położyć. Do rana.~
@547  = ~[will] Hm, faktycznie — nawet o tym nie pomyślałem. To wcale nie taki zły pomysł.~
@548  = ~[will] Obiecuję, że nie będę oszukiwał, pytając duchy o twoją rękę. Wolę zachować moce na ważniejsze sprawy.~
@549  = ~[player] W porządku. Gramy.~
@550  = ~[player] Wolę odpocząć. Dobranoc, Willu.~
@551  = ~[will] Dobrze, tylko przetasuję talię, zanim rozdam… dobra, teraz moja kolej… masz pięć, zgadza się? No to zaczynaj.~
@552  = ~[will] Mogę cię o coś zapytać podczas gry? Ostatnio w mieście słyszałem plotkę, że pomioty Bhaala to czternastostopowe tytany, cuchnące siarką i miażdżące wszystko pod swoimi piętami. Co o tym sądzisz?~
@553  = ~[player] Chciałbym tak potrafić! Może wcale nie jestem prawdziwym pomiotem Bhaala?~
@554  = ~[player] Ludzie czasem wygadują dziwne rzeczy.~
@555  = ~[player] Tylko nikomu nie mów, ale… gdybym naprawdę chciał, mógłbym zrobić to i jeszcze więcej.~
@556  = ~[will] Hah… może rzeczywiście nim nie jesteś. Czy to by cię pocieszyło?~
@557  = ~[player] Oj tak, zdecydowanie. Heh.~
@558  = ~[will] Nie zrozum mnie źle, <CHARNAME>. Ani przez chwilę nie wątpię w twoją moc.~
@559  = ~[will] Ciekawe, ile jeszcze historii o tobie usłyszymy, zanim to wszystko się skończy.~
@560  = ~[will] W każdym razie… twoja kolej, <CHARNAME>. Zagrajmy do końca, zanim ogień zgaśnie!~
@561  = ~[player] W porządku. Słodkich snów.~
@562  = ~[will] Heh… wyglądasz na kompletnie zalanego, <CHARNAME>.~
@563  = ~[player] T-tak! *hik* Jestem!~
@564  = ~[player] N-nieee, wcale nie! Ja jesht… *hik* bardzo, BARDZO szczęśliwy! Patrz na ten kufel…! O, to nie kufel…?~
@565  = ~[player] Ugh… to jesht po proshtu… kiepśki dzień. Musiałem się napić, wiesz? *hik*~
@566  = ~[player] Z-zajmij się shobą! *hik*~
@567  = ~[will] Skoro jeszcze mówisz, to chyba dasz radę chodzić. Umiesz stać? Na bogów, chyba nigdy nie widziałem cię tak pijanego! Ile wypiłeś, <PRO_BROTHERSISTER>?~
@568  = ~[player] Tylko… *hik* trochę… chyba.~
@569  = ~[player] Hnn… po proshtu… piłem, jak dawali… aż ten cholerny barman… mnie shtopnął. *hik* Zepsuł mi zabawę.~
@570  = ~[player] Z-zajmij się shobą. Zejdź mi z drogi!~
@571  = ~[player] W takim razie… chyba mam tu gdzieś jeszcze jedną butelkę…~
@572  = ~[player] D-dawaj ją!~
@573  = ~[player] M-mógłbym cię pocałować! Dawaj, nalej jeszcze!~
@574  = ~[player] N-nie, już wystarczy… przed nami… długa droga…~
@575  = ~[player] E-ech, nieważne. Po prostu zejdź mi z drogi, dobra?~
@576  = ~[will] Ha! Naprawdę myślisz, że dam ci jeszcze więcej? Nie, nie, nie — zdecydowanie nie. Jeszcze jeden łyk i będziesz blady jak ja.~
@577  = ~[will] Dobrze widzieć, że w tej głowie zostało ci jeszcze trochę rozsądku! Heh.~
@578  = ~[will] Haha… próbowałeś popisać się swoją twardością, czy jak? Jestem pewien, że masz je wielkie i imponujące, ale naprawdę nie musiałeś opróżniać tylu butelek, żeby to udowodnić.~
@579  = ~[will] Haha… chciałeś pokazać, jaki jesteś twardziel? Widziałem to już nieraz w walce, nie musisz się sprawdzać w ten sposób.~
@580  = ~[will] Dobrze, koniec droczenia się z mojej strony. Potrzebujesz pomocy?~
@581  = ~[player] N-nie… w porządku. Świeże powietrze by mi się przydało.~
@582  = ~[player] Hmm… t-tak. Zdecydowanie by się przydało.~
@583  = ~[player] Nieee… wystarczyłoby mi ciepłe łóżko… albo koc… albo cokolwiek ciepłego i płaskiego pod plecami…~
@584  = ~[will] Dobrze, prowadź. Idę tuż za tobą… (na wypadek, gdybyś się przewrócił i rozbił sobie głowę…).~
@585  = ~[will] Dobrze. W sumie cieszę się, że nie mam węchu. Podejrzewam, że jutro będziesz potrzebował porządnej kąpieli.~
@586  = ~[will] Ciepłe i płaskie, powiadasz? Heh, to da się załatwić. Chodź, znajdziemy ci jakieś przyjemne miejsce do położenia się.~
@587  = ~[will] Myślałem o tym, co powiedziałeś mi ostatnim razem.~
@588  = ~[player] Jeśli uważasz, że powinniśmy o tym porozmawiać, to się zgadzam.~
@589  = ~[will] Czy byłoby zbyt wiele zapytać, czy zmieniłeś zdanie?~
@590  = ~[player] Musimy do tego wracać? Powiedzieliśmy już wszystko. Wolę iść naprzód, niż gonić za czymś, czego nie ma.~
@591  = ~[player] Tak. Myślę, że powinniśmy porozmawiać.~
@592  = ~[player] Ja… nie wiem.~
@593  = ~[will] Nie będę kłamał — zaskoczyłeś mnie wtedy. Ale… nie czuję tego samego.~
@594  = ~[will] Choć mogę wyglądać jak zwykły człowiek, to… nim nie jestem. Już nie. Ta postać, ta twarz należą do kogoś, kto dawno odszedł. Nie jestem taki jak ty.~
@595  = ~[will] Ta postać i ta twarz należą do człowieka, którego już nie ma na tym świecie. Choć mam wątpliwości jak żywy, nie potrafię czuć tak samo. Moja obecność w tym świecie wiąże się z innymi więzami niż twoja.~
@596  = ~[player] Czyli… nie możesz odwzajemnić moich uczuć?~
@597  = ~[player] Rozumiem. Po prostu… w wielu sprawach jesteś tak normalny, że czasem zapominam, kim naprawdę jesteś.~
@598  = ~[player] Słuchaj, nie chcę o tym rozmawiać. Myślę, że już wystarczająco jasno wyraziłeś swoje stanowisko.~
@599  = ~[will] Nie. Potrafię czuć, ale… inaczej niż ty. Nawet samo stanie tutaj, naprzeciw ciebie, odczuwam zupełnie inaczej, niż ty to odczuwasz.~
@600  = ~[player] To, że rozumiesz… wcale nie sprawia, że jest mi łatwiej.~
@601  = ~[will] Myślę, że oboje możemy się zgodzić, że ta sytuacja jest… trudna dla nas obojga.~
@602  = ~[player] Will… posłuchaj. Cokolwiek powiedziałem, nie chciałem zmieniać tego, co już między nami było. Przede wszystkim jesteś moim przyjacielem. Masz prawo czuć to, co czujesz, i rozumiem to. Wolałbym, żebyśmy zostali szczerymi przyjaciółmi, zamiast się wzajemnie unikać.~
@603  = ~[player] Nie… nie dla mnie. Przynajmniej teraz. Wystarczająco jasno wyraziłeś swoje stanowisko. Skupmy się na tym, co najważniejsze — na wrogach i zadaniu, które mamy do wykonania. Straciliśmy już coś, czego słowa nie przywrócą. Zapomnijmy o tym i idźmy dalej.~
@604  = ~[will] Pewnie masz rację. Byłeś po prostu szczery. Byłem zdezorientowany… nadal jestem, ale to minie. Powinienem się cieszyć, że nie dusiłeś tego w sobie, topiąc się w uczuciach w samotności.~
@605  = ~[will] Zgadzam się. Powinniśmy spróbować przez to przejść. To nie powinno nas powstrzymywać od rozmów.~
@606  = ~[will] Dobrze. W takim razie mamy to ustalone.~
@607  = ~[will] Wiesz co… jednak nie jestem pewien, czy potrafię po tym wszystkim rozmawiać z tobą jak dawniej. Nie — zmieniłem zdanie. Powinniśmy pozostać jedynie sojusznikami. Nie potrafię po prostu wrócić do zwykłej przyjaźni. Przepraszam, że w ogóle to poruszyłem.~
@608  = ~[player] Dobrze. Na razie ruszajmy dalej, ale obiecuję — jeszcze będzie okazja, by porozmawiać.~
@609  = ~[will] Rozumiem… teraz wszystko jest dla mnie jasne. Skoro tak chcesz, to… idźmy dalej.~
@610  = ~[will] <CHARNAME>, musiałem zapytać… czy wszystko z tobą w porządku? Dużo myślałem o tym, co powiedziałeś. O tej… sympatii do mnie. Mówiłeś, że wszystko jest w porządku i że możemy dalej współpracować, ale… chciałem się upewnić, że naprawdę tak jest.~
@611  = ~[player] Odrzucenie boli, ale już mi lepiej. Przynajmniej byłeś szczery.~
@612  = ~[player] Gdyby naprawdę ci zależało, powiedziałbyś coś, co chciałbym usłyszeć. Trzymaj się ode mnie z daleka.~
@613  = ~[player] Nie, wszystko w porządku. To ja powinienem przeprosić za to, że tak nagle to na ciebie zrzuciłem. Rozumiem twoje stanowisko i… wystarczy mi, że jesteśmy przyjaciółmi.~
@614  = ~[will] Uznałem, że lepiej powiedzieć prawdę, niż kłamać albo unikać cię bez końca. Bez urazy, ale… nie zmieniłbym zdania. Ani wtedy, ani teraz.~
@615  = ~[will] Nie przepraszaj. Nie zrobiłeś nic złego, przyznając się do swoich uczuć.~
@616  = ~[will] Pomyślałem, że powinienem zapytać… tak na wszelki wypadek. Zastanawiam się, czy moja obecność cię nie krępuje. Jeśli chcesz, żebym odszedł, to…~
@617  = ~[player] Nie. Zostań. Naprawdę, już wszystko jest w porządku.~
@618  = ~[player] J-ja… tak. Myślę, że tak będzie lepiej. Przepraszam.~
@619  = ~[player] Przynajmniej tyle masz rozumu. Zejdź mi z oczu.~
@620  = ~[player] Nawet o tym nie myśl. Chcę, żebyś został — i nie z powodu chwilowego zauroczenia. To już przeszłość.~
@621  = ~[will] Dobrze… to dobrze. Cieszę się, że to wiem.~
@622  = ~[will] Skoro to wszystko, to chyba dobry moment, żeby ruszyć dalej. Chodź, przyjacielu! Wciąż mamy wiele do zrobienia.~
@623  = ~[will] Ja… rozumiem. Niezależnie od tej decyzji, to był zaszczyt podróżować u twego boku. Niech sprzyjają ci wiatry — cokolwiek przyniesie przyszłość.~
@624  = ~[player] Heh. W porządku.~
@625  = ~[will] Przepraszam, że cię niepokoiłem.~

@626  = ~[will] Więc postanowiłeś zostać bohaterem? Nie wiem, czy to dobry pomysł.~
@627  = ~[player] Dlaczego nie? Myślałem, że ucieszy cię to, że pomagamy innym.~
@628  = ~[player] Nie robię tego, żeby cię zadowolić, Will. Nie próbuj mnie powstrzymywać przed tym, co sam uznaję za słuszne.~
@629  = ~[will] Nie jestem temu przeciwny, ale… każdy bohater coś traci. Stać cię na stratę większą, niż ta, którą już poniosłeś? Wiem, że robisz to z troski o innych — i to szlachetne — ale ryzykujesz własne życie. Czy jesteś gotów poświęcić wszystko, czym jesteś, dla innych?~
@630  = ~[nalia] Może <PRO_HESHE> nie powin<PRO_HESHE> poświęcać <PRO_HIMHER> się bez reszty, ale nie możemy też stać z boku, skoro mamy moc, by pomagać innym, Will. Myślałam, że przynajmniej to zrozumiesz.~
@631  = ~[will] Rozumiem, Nalia. Nie mam nic przeciw pomaganiu, ale nie chcę patrzeć, jak <CHARNAME> ginie dla cudzej sprawy, zanim zrealizuje własne cele.~
@632  = ~[player] Nie zapominam o sobie, Will. Zawsze zostawiam dość, by zadbać o własne potrzeby.~
@633  = ~[player] Nie martw się, Nalia. Zgadzam się z tobą. Chcę uczynić świat lepszym — i dla innych, i dla siebie. Właśnie dlatego to robię.~
@634  = ~[player] Pomaganie innym też jest moim celem, Will. Nie zamierzam stać z boku i patrzeć, jak podli i odrażający krzywdzą niewinnych. Chcę uczynić ten świat najlepszym, na jaki mnie stać.~
@635  = ~[player] Jest w tym dla mnie korzyść. Bohaterstwo przynosi nagrody. Nie obchodzi mnie, czy nazwą mnie bohaterem czy najemnikiem — ważne, żebym dostał to, na co zasłużyłem swoimi czynami.~
@636  = ~[player] Cokolwiek, Will. Nie jestem tu po to, by spełniać twoje zachcianki. Ruszajmy dalej.~
@637  = ~[will] To dobrze. Nie chciałbym, żebyś stracił własną drogę, pomagając innym na ich.~
@638  = ~[player] Jesteś całkiem pewny, że ci się to uda.~
@639  = ~[will] Rozumiem.~
@640  = ~[will] Znasz opowieści o największych bohaterach. Ludzie ich wychwalają, ale każdy z nich coś traci. Rodzinę, życie, miłość… a czasem nawet spokój. To wysoka cena.~
@641  = ~[will] Nie powiem ci, byś ignorował cierpienie innych, ale pamiętaj, że ty też cierpisz. Nie poświęcaj siebie dla wszystkich. Pomagaj, jeśli musisz — ale nie kosztem siebie.~
@642  = ~[player] Dlaczego mówisz mi to dopiero teraz?~
@643  = ~[player] Wiem, do czego zmierzasz, Will. Nie martw się. Wiem, gdzie postawić granicę.~
@644  = ~[player] Myślę, że znam konsekwencje swoich działań lepiej niż ty, Will.~
@645  = ~[player] *Westchnienie* Możemy dać temu spokój? I tak nie dojdziemy do porozumienia.~
@646  = ~[will] Bo ludzie już cię znają. Wszyscy o tobie mówią. Wiedzą, że mogą prosić cię o pomoc w swoich sprawach — żebyś ratował ich z kłopotów.~
@647  = ~[player] Jeśli to prawda, to się cieszę.~
@648  = ~[will] Powtórzę jeszcze raz: nie mówię, żebyś ignorował cierpiących, tych, których życie wisi na włosku. Ale czy naprawdę każdy, kto zgubił psa albo sakiewkę, musi nas zatrzymywać, gdy Irenicus jest tuż przed tobą? Myślałem, że to zrozumiesz.~
@649  = ~[will] Nie sądziłem, że jesteś aż tak zajęty, by nie znaleźć nawet chwili, żeby mnie wysłuchać. Dobrze. Prowadź.~

@650  = ~[will] Ja… czuję tu dziwną obecność. Jakaś potężna siła mnie chwyta… i nie chce puścić. Te szepty… one… <CHARNAME>, co się dzieje?!~
@651  = ~[will] To miejsce…~
@652  = ~[will] Chyba już rozumiem. To miejsce… jest schronieniem duchów — i dlatego mnie przywołało. Jest jak Wizjonarium, ale… podłe i okrutne. Mroczne istoty nazywają je domem, <CHARNAME>. Krzyczą o krew, o głód, o potrzebę żerowania…~
@653  = ~[player] Żerowania… na czym?~
@654  = ~[player] Chcesz powiedzieć to, co myślę, że chcesz powiedzieć?~
@655  = ~[will] …na nas. Tak, obawiam się, że chcą pożreć nas. Nie tylko naszą krew, ale też energię, sny i nadzieję. Wszystko, co daje życie.~
@656  = ~[player] Wspaniale. Po prostu cudownie! Nie wiesz może, jak się stąd wydostać, zanim zostaniemy obiadem?~
@657  = ~[player] Hmm… ale musi być jakieś wyjście, prawda?~
@658  = ~[player] Ha! Wygląda na to, że szykuje się niezła zabawa.~
@659  = ~[player] Hmm… muszę się rozejrzeć i pomyśleć…~
@660  = ~[will] Miejsca takie jak to zwykle mają jakiegoś opiekuna… strażnika. Jeśli chcemy uciec, musimy się nim zająć… siłą, jeśli zajdzie taka potrzeba. To osłabi zasłonę otaczającą to miejsce.~
@661  = ~[player] Ale taka istota może być bardzo potężna, prawda?~
@662  = ~[player] Dobra. Rozejrzyjmy się. Mam lepsze rzeczy do roboty niż błąkanie się tu bez końca.~
@663  = ~[will] Bez wątpienia. Ale dowiemy się tylko wtedy, gdy ich znajdziemy — i to szybko, zanim oni znajdą nas.~
@664  = ~[will] Masz rację. Idę tuż za tobą.~

@665  = ~[narrator] *Nowe istoty wkroczyły do mego siedliska. Inne niż pająki i czarne elfy z Wielkiej Jaskini! Wyczuwam cię, istoto z ciała — twój oddech, twoją energię, twoje pragnienia. Najpierw poczułem tylko ducha, ale wiedziałem, że kroczy przy nim coś więcej… coś większego.*~
@666  = ~[will] Więc ta istota wyczuła najpierw mnie? Ale… chyba wie, kim jesteś, <CHARNAME>.~
@667  = ~[narrator] *Tak… Wiem, kim jesteś i kim masz się stać. W tobie drzemie wielki potencjał, istoto z ciała. To niemal wyryte w twej esencji. Gdybym cię pożarł, moja moc wzrosłaby dziesięciokrotnie. Mógłbym uczynić swój dom potężnym — ponad wszelkie pojęcie!*~
@668  = ~[player] Co?! Chcesz mnie zjeść?!~
@669  = ~[player] O nie… świetnie.~
@670  = ~[narrator] *Tak, istoto z ciała. Czy nie byłem dość jasny?*~
@671  = ~[narrator] *Wiem, że nie jesteś obcy miejscom takim jak to, istoto. Widzę słowo „Wizjonarium” w twoim umyśle. Widzę obrazy tej żałosnej groty. Jest tylko pyłkiem w porównaniu z moim władztwem! To gniazdo ma stać się wielkie… domem wiecznej energii.*~
@672  = ~[narrator] *A ty, istoto… *ty* jesteś kluczem do jej uwolnienia.*~
@673  = ~[player] Nie interesują mnie twoje plany! Pozwól nam odejść, póki nie pożałujesz.~
@674  = ~[player] Chcesz walki, bestio? To ją dostaniesz!~
@675  = ~[narrator] *Twoje żałosne istnienie ma tylko jeden cel… by nas nakarmić i wzmocnić.*~

@676  = ~[will] To… to stworzenie było najbardziej niezwykłą rzeczą, jaką widziałem w życiu… i po śmierci. Było śmiercionośne. Energia, jaką dysponowało, była niewyobrażalna. Szkoda, że została zmarnowana na sianie grozy.~
@677  = ~[will] Bez niego to miejsce umrze — powoli, lecz nieuchronnie. Wątpię, by pojawił się nowy strażnik. Może to nawet dobrze… obecność tej bestii zepsuła duchy, które wcześniej nazywały to miejsce domem.~
@678  = ~[will] Widziałeś błyski. Były dzikie, okrutne — bardziej niż inne ich rodzaje. Pragnęły pożreć naszą energię.~
@679  = ~[will] To miejsce zasługuje na śmierć. Może kiedyś odrodzi się jako coś lepszego.~
@680  = ~[player] Will, to nie pora na dyskusję o losie bestii ani tego miejsca. Musimy się stąd wydostać jak najszybciej.~
@681  = ~[will] Mam taką nadzieję. Powinniśmy przeszukać szczątki bestii. Może znajdziemy coś, co pomoże w ucieczce.~
@682  = ~[player] Tak, masz rację. Przeszukajmy szczątki bestii. Może znajdziemy coś, co pomoże w ucieczce.~
@683  = ~[will] Ach… dotarliśmy do głównej jaskini. Możemy wrócić do pierwotnego zadania, <CHARNAME>. Prowadź.~
@684  = ~[will] Jak się czujesz, <CHARNAME>? Ta przemiana, którą ci narzucono, była zbyt okrutna. Przykro mi.~
@685  = ~[player] Czemu przepraszasz?~
@686  = ~[player] Wątpię, byś mógł coś zrobić, Will. Nie udawaj, że było inaczej.~
@687  = ~[player] Masz w tym jakiś cel, czy tylko patrzysz na mnie jak na chore zwierzę? Nie potrzebuję litości. Daj mi spokój, żebyśmy mogli ruszyć dalej.~
@688  = ~[will] Chciałbym tylko, żeby było coś, co mógłbym zrobić. Gdybym tylko był silniejszy… mógłbym powstrzymać tego śmiecia, Irenicusa, zanim wyrządziłby więcej zła.~
@689  = ~[will] Wydajesz się rozdrażniony, <CHARNAME>. Chciałem tylko powiedzieć, że mi zależy.~
@690  = ~[will] Martwię się o ciebie, <CHARNAME>. Nie wiem, co zrobił ci Irenicus, ale wyglądasz na… niepełnego. Jakby coś w tobie zniknęło. Jakby—~
@691  = ~[player] Jakbym stracił duszę? Tak — właśnie to się stało. Ale nie martw się. Odzyskamy ją.~
@692  = ~[player] Doceniam twoje wsparcie, Will. Jeśli zabrzmiałem, jakbym miał dość twojej troski, przepraszam. Po prostu… czuję się osłabiony. I niepełny.~
@693  = ~[player] Przez chwilę mogłem znosić twoje durne szturchanie, ale mam dość. Zejdź mi z drogi!~
@694  = ~[player] Will… dlaczego? Dlaczego to wszystko musi spotykać właśnie mnie? Czemu — na wszystkie Dziewięć Piekieł — zawsze muszą czyhać na moje życie albo duszę… albo po prostu na mój upadek? Mam dość… jestem tak strasznie zmęczony.~
@695  = ~[will] Odzyskamy ją. Przysięgam ci — odzyskamy. Znajdziemy Irenicusa i zrobimy wszystko, co trzeba, żebyś wrócił do siebie.~
@696  = ~[will] Czuję to. Przyjmuję przeprosiny, <CHARNAME>… rozumiem.~
@697  = ~[will] Nie wiem. Przykro mi. Może to przez twoją krew, ale uwierz mi — jeśli tylko wymusimy zmianę, wszystko zacznie iść ku lepszemu. I właśnie to zrobimy.~
@698  = ~[will] Ja… przyznam, gdy zobaczyłem, jak się zmieniasz, pomyślałem, że naprawdę przegraliśmy. A potem znalazłeś sposób… jakoś, wbrew wszystkiemu, odnalazłeś moc, by odzyskać ciało i umysł. Wtedy zrozumiałem, że jeszcze nic nie jest stracone. Masz w sobie siłę, której Irenicus nie potrafi dostrzec ani odebrać. Coś znacznie większego, niż ktokolwiek z nas mógłby mieć. Coś, co na zawsze wyryje się w twojej woli.~
@699  = ~[player] Eee… nie do końca ogarniam to całe szamańskie mamrotanie, ale… dzięki, Will. Spróbujemy ze wszystkich sił. Oby to wystarczyło.~
@700  = ~[player] Znam siebie. Wiem, gdzie są moje granice — i nawet się do nich nie zbliżyłem. Jeśli sprawię, że coś się zmieni, to się zmieni. Zobaczysz.~
@701  = ~[player] Dzięki za dobre słowa, Will.~
@702  = ~[player] Cokolwiek. Daj mi odetchnąć, żebyśmy mogli iść dalej.~
@703  = ~[player] Odzyskamy twoją duszę… albo zginiemy, próbując. Ale wiem, że będzie to to pierwsze.~
@704  = ~[will] Heh… rozumiem. Irenicus mógł ci ukraść duszę, ale… wygląda na to, że nikt nie ukradnie ci pewności siebie.~
@705  = ~[will] Jeszcze jedno… ta istota, w którą się przemieniłeś. Uważaj. Nie trzeba szamańskiego wzroku, by wiedzieć, że to śmiertelnie niebezpieczne. Jej pazury potrafią rozszarpać i ciało, i duszę — jak żadna broń. Dlatego ostrzegam cię raz jeszcze… proszę, bądź ostrożny.~
@706  = ~[player] Będę. Ale jeśli będę musiał znów się w to zmienić… mam nadzieję, że kiedyś zdołam to opanować. Nieważne — ruszajmy.~
@707  = ~[player] Oby starczyło mi siły, by zakuć tę moc głęboko we mnie, żeby nigdy więcej nie wypłynęła. Chodźmy.~
@708  = ~[player] Obyśmy już nigdy nie ujrzeli tej bestii. No… ruszajmy.~
@709  = ~[player] Aye. Ruszajmy.~
@710  = ~[will] Hm… rozumiem. Wolałbyś, żebym ci już nie zawracał głowy.~

@711  = ~[will] Nigdy nie spodziewałem się, że zobaczę miasto drowów na własne oczy. Nie da się zaprzeczyć: choć mroczne elfy bywają zdradzieckie i podłe, mają talent do tworzenia rzeczy pięknych.~
@712  = ~[player] Nie widzę tu piękna. Tylko konstrukcje tak wypaczone, jak bestie, które je wzniosły.~
@713  = ~[player] Wygląda to… dość intrygująco. Nigdy nie widziałem niczego tak… monumentalnego. Ani tak kolczastego, swoją drogą. Ugh.~
@714  = ~[player] To okropne. Czuję się jak drobnica w paszczy rekina.~
@715  = ~[player] To nie czas ani miejsce na pogawędki. Ruszajmy.~
@716  = ~[will] Cóż… może masz rację. Ta architektura jest niepokojąca w swoim zepsuciu, ale… nie potrafię powiedzieć, że jest brzydka. Wciąż jest dziełem sztuki… w tym, jak twórcy bawili się formą i kształtem.~
@717  = ~[will] Heh… trafne porównanie, choć sam bym na nie nie wpadł.~
@718  = ~[will] Nigdy nie brałem pod uwagę, że naturalne skały — stalagmity czy stalaktyty — można tak wyrzeźbić, by stały się domami… albo że jamy można wypełnić takimi budowlami.~
@719  = ~[will] A same drowy… cóż. Nie spodziewałem się, że w jednym miejscu będzie ich aż tyle.~
@720  = ~[player] To martwi mnie najbardziej. Jeden podejrzany ruch — i będą nas mieli z każdej strony. Jesteśmy kompletnie, beznadziejnie w mniejszości.~
@721  = ~[player] Musimy uważać. To leże samych pająków. Jeśli choć trochę się potkniemy — zginiemy.~
@722  = ~[player] To zbyt ryzykowne, żeby teraz gadać, Will. Idźmy dalej, zanim ktoś nas zdemaskuje.~
@723  = ~[will] W takim razie działajmy mądrze i ostrożnie. Jeśli nie możemy ich wszystkich zabić, spróbujmy tego nie robić. Może przetrwamy to piekło tak, by nikt niczego się nie domyślił. Po tym wszystkim nie chciałbym, żebyśmy dali się teraz zarżnąć drowom.~
@724  = ~[will] Chodź… nie wzbudzajmy podejrzeń.~
@725  = ~[will] Być może masz rację. Ruszajmy.~

@726  = ~[will] Dobrze znów zobaczyć światło. Po całym czasie spędzonym w Spellhold, a potem w tunelach Podmroku… brakowało mi tego.~
@727  = ~[player] Też tak mam. Miałem dość niebezpieczeństwa, mroku, drowów i wszystkich potworów czających się w ciemności.~
@728  = ~[player] Prawie żadnej różnicy. Wróciliśmy, ale nasza sytuacja wcale się nie poprawiła.~
@729  = ~[player] Nie mamy czasu na rozmowy, Will. Musimy powstrzymać wrogów — są zbyt blisko spełnienia swoich chorych marzeń.~
@730  = ~[will] Cóż, nie powiem, że skończyliśmy z walką z kolejnymi przeklętymi stworami… ale przynajmniej w innych okolicznościach.~
@731  = ~[will] Myślę, że jest różnica. Znów stąpamy po ziemi, którą znamy — tu jesteśmy bezpieczniejsi. A nasi wrogowie — Bodhi i Irenicus — mają coraz mniej miejsc, w których mogą się ukryć.~
@732  = ~[will] Wciąż zastanawiam się, jakie pułapki Bodhi na nas szykuje. Nie mam wątpliwości, że czekają nas kolejne koszmary. Irenicus jest mózgiem, ale Bodhi to jego ostre kły i śmiercionośne pazury. Zbyt niebezpiecznie byłoby pozwolić jej znów uciec, <CHARNAME>.~
@733  = ~[player] Myślisz, że bym na to pozwolił? Jeśli tak, to wciąż mnie nie znasz, Will.~
@734  = ~[player] Nie obchodzi mnie, co się z nią stanie. Wezmę to, czego potrzebuję, a reszta mnie nie interesuje.~
@735  = ~[player] I tak od dawna mam ją na liście. Wiem, jaka jest groźna. Nie musisz mi tłumaczyć, że trzeba ją zgładzić dla dobra niewinnych.~
@736  = ~[player] Możemy znaleźć lepszy moment na rozmowę, Will? Teraz mam zbyt wiele na głowie.~
@737  = ~[will] Wybacz, że w ciebie zwątpiłem. Wiem, że nie pozwoliłbyś bestii tak po prostu uciec.~
@738  = ~[will] To ważne, więc proszę… przemyśl to. Możesz ją pokonać, ale jeśli nie dopilnujesz, by to był koniec, wróci. Po ciebie — i po każdego, kto jej się sprzeciwił. Ryzyko jest zbyt wielkie, by nie zakończyć tego raz na zawsze.~
@739  = ~[will] Dobrze… ulżyło mi, że to słyszę.~
@740  = ~[will] A co do bitwy, która niewątpliwie nadejdzie… wiem, jak potężna jest Bodhi, ale… mogę mieć plan. To niebezpieczne, lecz… dzięki mojej mocy, a także błyskom i duchom, które słyszą moje wezwanie, możemy stanąć w pierwszym szeregu przeciw jej wampirom. Jej rodzaj potrafi wysysać życie z żywych — ale nie ze mnie. W końcu ja też jestem martwy.~
@741  = ~[will] Jeśli zapewnisz mi bezpieczeństwo, uwolnię legion wiernych duchów przeciw naszemu wrogowi, a gdy nadejdzie właściwa chwila — ugodzimy ją w czarne serce.~
@742  = ~[player] Brzmi jak plan.~
@743  = ~[player] Zobaczymy. Wciąż muszę przemyśleć najlepsze rozwiązanie.~
@744  = ~[player] Wolałbym po prostu zabić ją własnymi rękami. Jestem pewien, że jesteśmy dość silni.~
@745  = ~[will] Oby to wystarczyło. Musimy przygotować się na nieuniknioną bitwę. Upewnijmy się, że naprawdę jesteśmy na nią gotowi.~
@746  = ~[will] Rozumiem. Ufam twojemu przywództwu, <CHARNAME>, skoro doprowadziłeś nas aż tutaj. Przygotujmy się na nieuniknioną bitwę. Upewnijmy się, że naprawdę jesteśmy na nią gotowi.~
@747  = ~[will] Obyś miał rację. Musimy przygotować się na nieuniknioną bitwę. Upewnijmy się, że naprawdę jesteśmy na nią gotowi.~
@748  = ~[will] Dobrze… prowadź. Idę tuż za tobą.~
@749  = ~[will] Więc to słynne elfie miasto… Muszę przyznać, że przypomina mi drowy — Ust Natha, tak? Szkoda byłoby patrzeć na jego upadek. Musimy powstrzymać Irenicusa jak najszybciej, <CHARNAME>. Chodźmy.~

@750  = ~[narrator] Will Rattlemoth, upiorny szaman, który opuścił Wizjonarium, by podróżować u twego boku, patrzy na ciebie ze spokojną akceptacją. Wspierał cię całą swoją mocą aż do tej pory, ale zastanawiasz się, czy jest gotów zaryzykować samo swoje istnienie dla ciebie.~
@751  = ~[player] Pomogłeś mi tak bardzo, bracie, ale czy na pewno chcesz iść za mną w to wszystko? To może być naprawdę niebezpieczne. A jeśli tym razem nie zdołasz wrócić do swego grobu?~
@752  = ~[player] Jesteś na to gotów, Will?~
@753  = ~[player] Wiesz… nie musisz iść ze mną, jeśli nie chcesz…~
@754  = ~[will] Heh, chcę iść. Muszę ci pomóc. Nigdy bym sobie nie wybaczył, gdybym zostawił cię tutaj, kiedy potrzebujesz mojej mocy. Będziesz potrzebował wszystkiego i wszystkich, by zgładzić tego potwora, Irenicusa.~
@755  = ~[will] Bez względu na to, co nas czeka — jestem gotów. Wiedz, że jestem z tobą. Wreszcie zakończymy to raz na zawsze.~

@756  = ~[player] To szaleństwo. Nie mogę uwierzyć, że ten troll z własnej woli sprowadził tyle zniszczeń. Przeklęta bestio, oby twoja dusza gniła w Otchłani!~
@757  = ~[torgal] Ha! Marny duch chce grozić TorGalowi? Słabeusz! TorGal nie lęka się martwych, takich jak ty!~
@758  = ~[will] Ziemia krzyczy od ran zadanych jej przez jej czyny. Dziwię się, że ona tego nie słyszy — nawet jeśli jest druidką.~
@759  = ~[will] Czekaj, <CHARNAME>. Chyba… raz widziałem myśli tego człowieka. Porozmawiajmy, zanim dobyjemy kling.~
@760  = ~[will] Znasz ją? Nawet jeśli jest drowką, nie mogę się zgodzić na ten okrutny spektakl. Tylko ktoś naprawdę chory czerpałby radość z patrzenia, jak płonie jej ciało. Może to ci ludzie w istocie zasługują na pal.~
@761  = ~[will] Smutek wyryty jest w tej biednej duszy. Wysłuchajmy tego chłopca, <CHARNAME>.~
@762  = ~[will] Spocznij, dziecko. Znajdziesz spokój, na jaki zasługujesz. Wsłuchaj się w szepty, które cię wzywają… i podążaj.~
@763  = ~[boy] Chyba mogę… mogę je słyszeć…~
@764  = ~[will] Uważaj, <CHARNAME>. Ludzie tacy jak on zawsze kończą otoczeni krwią i trupami.~
@765  = ~[will] Ona próbuje cię sprowokować słowami, <CHARNAME>. Uważaj.~
@766  = ~[mage] Ha… myślisz, że przejrzysz moje działania, małe widmo? Żałosne. Dla własnego dobra powinieneś był zostać w swojej marnej grocie.~
@767  = ~[player] Czemu magowie zawsze zaczynają rozmowę od obelgi?~
@768  = ~[will] Nie sądzę, że powinniśmy go zabijać, <CHARNAME>. Nikt nie dowie się, jeśli po prostu… zniknie.~
@769  = ~[will] To dla niego zabawa? Przeklęty gad… Chcę widzieć go martwym, <CHARNAME>. Jego czyny zbezcześciły tę niegdyś spokojną krainę i zamieniły ją w miejsce skażenia.~
@770  = ~[will] Tyle… tyle duchów mówi o tej kobiecie… tyle szeptów, przekleństw, potępień…~
@771  = ~[player] Trochę mnie dziwi, że ktoś taki urządził się w kanałach… zakładając, że to wciąż kanały.~
@772  = ~[will] (szept) <CHARNAME>, chyba się zakochuję… w obserwatorze.~
@773  = ~[player] Tylko szaleniec uwierzyłby, że wysłał nas Sekolah.~
@774  = ~[will] To— to stworzenie jest majestatyczne! Gdyby nam pomogło, moglibyśmy rozbić siły Irenicusa!~
@775  = ~[will] Musiał użyć tego w jeszcze bardziej okrutny sposób… duchy tej krainy umierają. Przegrywają z Irenicusem i siłami z innego świata, które przywołał. Ich krzyki rozbrzmiewają w mojej głowie. Musimy to przerwać.~
@776  = ~[will] Zakończ to, Irenicusie! Czy jesteś głuchy na błagalne wołanie duchów? Krzyczą tak głośno, że ledwo słyszę własne myśli! PRZESTAŃ!~
@777  = ~[irenicus] Nic mnie nie obchodzi miauczenie umarłych, głupi duchu. Nie waż się sądzić, że rozumiesz moje czyny! Nie zatrzymam się przed niczym!~
@778  = ~[player] To takie okrutne…~

